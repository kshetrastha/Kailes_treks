@section scripts {
<script src="~/cusassests/js/plugins/flatpickr.js"></script>
<script>
(function () {
    // ── Flatpickr date pickers ────────────────────────────────────────────
    const baseOpts = { dateFormat: 'Y-m-d', allowInput: false, disableMobile: false };
    flatpickr('#arrivalDate',   { ...baseOpts, minDate: 'today' });
    flatpickr('#departureDate', { ...baseOpts, minDate: 'today' });
    flatpickr('#dateOfBirth',   { ...baseOpts, maxDate: new Date(new Date().setFullYear(new Date().getFullYear() - 10)) });
    flatpickr('#dateOfIssue',   baseOpts);
    flatpickr('#expiryDate',    { ...baseOpts, minDate: 'today' });

    // ── Package & month selection ─────────────────────────────────────────
    let selectedPrice = 0, bkQty = 1;
    const monthNames = {1:'January',2:'February',3:'March',4:'April',5:'May',6:'June',7:'July',8:'August',9:'September',10:'October',11:'November',12:'December'};
    const fmt = n => '$' + n.toLocaleString('en-US', {maximumFractionDigits:0});

    document.querySelectorAll('input[name="packageMonth"]').forEach(radio => {
        radio.addEventListener('change', function () {
            const pkgId = parseInt(this.dataset.packageId);
            const month = parseInt(this.dataset.month);
            document.getElementById('hiddenPackageId').value    = pkgId;
            document.getElementById('hiddenSelectedMonth').value = month;
            selectedPrice = parseFloat(this.dataset.price);
            document.getElementById('summaryPackageName').textContent = this.dataset.packageName;
            document.getElementById('summaryMonth').textContent       = monthNames[month];
            document.getElementById('summaryPrice').textContent       = fmt(selectedPrice) + ' / person';
            updateTotal();
        });
    });

    function bkChangeQty(d) {
        bkQty = Math.max(1, bkQty + d);
        document.getElementById('bkQtyDisplay').textContent = bkQty;
        document.getElementById('hiddenQty').value = bkQty;
        updateTotal();
    }
    window.bkChangeQty = bkChangeQty;

    function updateTotal() {
        if (!selectedPrice) return;
        const total = selectedPrice * bkQty;
        document.getElementById('bkPriceLabel').textContent = fmt(selectedPrice) + ' × ' + bkQty + ' person(s)';
        document.getElementById('bkSubtotal').textContent   = fmt(total);
        document.getElementById('bkTotalFinal').textContent = fmt(total);
    }

    // ── Health declaration ────────────────────────────────────────────────
    const healthState = {};
    document.querySelectorAll('.bk-toggle-btn').forEach(btn => {
        healthState[btn.dataset.condition] = false;
    });
    function syncHealth() {
        document.getElementById('healthDeclarationInput').value = JSON.stringify(healthState);
    }
    syncHealth();

    window.bkToggle = function (btn, type) {
        const group = btn.closest('.bk-toggle-group');
        group.querySelectorAll('.bk-toggle-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        healthState[btn.dataset.condition] = (type === 'yes');
        syncHealth();
    };

    // ── Cancellation policy accordion ─────────────────────────────────────
    window.bkTogglePolicy = function (btn) {
        const body   = btn.nextElementSibling;
        const isOpen = body.classList.contains('open');
        document.querySelectorAll('.bk-policy-body').forEach(b => b.classList.remove('open'));
        document.querySelectorAll('.bk-policy-toggle').forEach(b => b.classList.remove('open'));
        if (!isOpen) { body.classList.add('open'); btn.classList.add('open'); }
    };

    // ── Validate package selected before submit ───────────────────────────
    document.getElementById('kailashBookingForm').addEventListener('submit', function (e) {
        const pkgId = document.getElementById('hiddenPackageId').value;
        if (!pkgId || pkgId === '0') {
            e.preventDefault();
            alert('Please select a Yatra Package and Month from the table above before submitting.');
            return;
        }
    });
})();
</script>
}
