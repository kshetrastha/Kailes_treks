@model TravelCleanArch.Web.Models.Package.PackageBookingFormViewModel
@{
    ViewData["Title"] = $"Book {Model.Package.Name}";
    var p = Model.Package;
    var currency = p.CurrencyCode;
    var hasPrice = !p.PriceOnRequest && p.Price is not null;

    var heroImage = string.IsNullOrWhiteSpace(p.HeroImageUrl)
        ? Url.Content("~/cusassests/images/tour/tour-img-9.png")
        : (p.HeroImageUrl.Trim().StartsWith("~/", StringComparison.Ordinal)
            ? Url.Content(p.HeroImageUrl.Trim())
            : p.HeroImageUrl.Trim());
}

<style>
    /* Booking page refinements. Scoped to this page and built on the theme variables so it
       stays in step with the rest of the site rather than introducing a second palette. */
    .bd-booking-area .booking-section-title {
        font-size: 18px;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--bd-border-primary);
    }

    .bd-booking-area .booking-form-input-title label .optional {
        color: var(--bd-text-body);
        font-size: 14px;
        font-weight: 400;
        margin-inline-start: 4px;
    }

    .bd-booking-area .booking-form-input textarea {
        min-height: 120px;
        padding-top: 15px;
        resize: vertical;
    }

    /* Give the themed dropdown the same footprint as the text inputs next to it. */
    .bd-booking-area .booking-form-input .nice-select {
        width: 100%;
        height: 56px;
        line-height: 54px;
        border-radius: 4px;
        border: 1px solid var(--bd-border-primary);
        background-color: var(--bd-white);
        padding-inline-start: 25px;
        padding-inline-end: 40px;
        font-size: 16px;
        color: var(--bd-black);
        float: none;
    }

    .bd-booking-area .booking-form-input .nice-select.open,
    .bd-booking-area .booking-form-input .nice-select:focus {
        border-color: var(--bd-primary);
    }

    .bd-booking-area .booking-form-input .nice-select .list {
        width: 100%;
        max-height: 260px;
        overflow-y: auto;
    }

    /* Flatpickr swaps the field for a readonly text input; keep the theme look and a pointer. */
    .bd-booking-area .booking-form-input input.js-date {
        cursor: pointer;
        background-color: var(--bd-white);
    }

    .bd-booking-area .booking-sidebar-widget-thumb img {
        height: 200px;
        object-fit: cover;
    }

    .bd-booking-area .booking-summary-name {
        font-size: 20px;
        line-height: 1.3;
    }

    .bd-booking-area .booking-sidebar-divider {
        height: 1px;
        background-color: var(--bd-border-primary);
        margin: 24px 0;
    }

    .bd-booking-area .booking-sidebar-price-item span:first-child {
        color: var(--bd-text-body);
    }

    .bd-booking-area .booking-sidebar-total {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--bd-border-primary);
        font-size: 18px;
    }

    .bd-booking-area .booking-sidebar-total strong:last-child {
        color: var(--bd-primary);
    }

    .bd-booking-area .booking-sidebar-note {
        margin-top: 16px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--bd-text-body);
    }

    .bd-booking-area .alert ul {
        margin-bottom: 0;
        padding-inline-start: 18px;
    }

    @@media (max-width: 991px) {
        /* Below lg the columns reorder so the summary comes first (see order-* classes),
           and the sidebar must not be sticky or indented once stacked. */
        .bd-booking-area .booking-sidebar-wrapper {
            position: static;
            margin-left: 0;
        }
    }
</style>

<div class="section-space-top"></div>

<!-- breadcrumb area start -->
<section class="bd-breadcrumb-area p-relative fix">
    <div class="bd-breadcrumb-bg" data-background="/cusassests/images/bg/breadcrumb-bg.png"></div>
    <div class="bd-breadcrumb-wrapper p-relative">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <div class="bd-breadcrumb d-flex align-items-center justify-content-center">
                        <div class="bd-breadcrumb-content text-center">
                            <h1 class="bd-breadcrumb-title">Complete Your Booking</h1>
                            <div class="bd-breadcrumb-list">
                                <span><a href="/"><i class="icon-home"></i>Home</a></span>
                                <span><a asp-controller="Package" asp-action="TrekkingDetails" asp-route-slug="@p.Slug">@p.Name</a></span>
                                <span>Booking</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- breadcrumb area end -->

<section class="bd-booking-area section-space">
    <div class="container">
        <div class="row gy-24">

            <!-- ============ BOOKING FORM ============ -->
            <div class="col-xxl-8 col-xl-8 col-lg-7 order-2 order-lg-1">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-24">
                        <strong class="d-block mb-5">Please check the highlighted fields</strong>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form class="booking-form" method="post"
                      asp-controller="Package" asp-action="Book" asp-route-slug="@p.Slug" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- TRIP DETAILS -->
                    <div class="booking-form-section mb-40">
                        <h5 class="booking-section-title">Trip Details</h5>

                        <div class="booking-card-grid">
                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="NumberOfTravellers">Number of Travellers <span>*</span></label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="NumberOfTravellers" type="number" min="1" max="100" id="travellerCount" />
                                </div>
                                <span asp-validation-for="NumberOfTravellers" class="text-danger"></span>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="PreferredStartDate">Preferred Start Date</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="PreferredStartDate" asp-format="{0:yyyy-MM-dd}"
                                           type="text" id="preferredStartDate" class="js-date"
                                           placeholder="Select a date" autocomplete="off" />
                                </div>
                                <span asp-validation-for="PreferredStartDate" class="text-danger"></span>
                            </div>
                        </div>

                        @if (p.FixedDepartures.Count > 0)
                        {
                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="FixedDepartureId">Fixed Departure <span class="optional">(optional)</span></label>
                                </div>
                                <div class="booking-form-input">
                                    <select asp-for="FixedDepartureId" class="input-box-select">
                                        <option value="">Choose a scheduled departure</option>
                                        @foreach (var d in p.FixedDepartures)
                                        {
                                            <option value="@d.Id">
                                                @d.StartDate.ToString("dd MMM yyyy") &ndash; @d.EndDate.ToString("dd MMM yyyy") (@d.ForDays days@(d.GroupSize is > 0 ? $", {d.GroupSize} seats" : ""))
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- PERSONAL DETAILS -->
                    <div class="booking-form-section mb-40">
                        <h5 class="booking-section-title">Personal Details</h5>

                        <div class="booking-card-grid">
                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="FirstName">First Name <span>*</span></label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="FirstName" type="text" placeholder="Given name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="LastName">Last Name <span>*</span></label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="LastName" type="text" placeholder="Family name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="Email">Email <span>*</span></label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="Email" type="email" placeholder="you@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="Phone">Phone <span>*</span></label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="Phone" type="tel" placeholder="+977 98XXXXXXXX" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="AlternatePhone">Alternate Phone / WhatsApp</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="AlternatePhone" type="tel" placeholder="Optional" />
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="DateOfBirth">Date of Birth</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}"
                                           type="text" id="dateOfBirth" class="js-date"
                                           placeholder="Select a date" autocomplete="off" />
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="Gender">Gender</label>
                                </div>
                                <div class="booking-form-input">
                                    <select asp-for="Gender" class="input-box-select">
                                        <option value="">Select gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                        <option value="Prefer not to say">Prefer not to say</option>
                                    </select>
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="Nationality">Nationality</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="Nationality" type="text" placeholder="e.g. Nepali" />
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="PassportNumber">Passport Number</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="PassportNumber" type="text" placeholder="Optional" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ADDRESS -->
                    <div class="booking-form-section mb-40">
                        <h5 class="booking-section-title">Address</h5>

                        <div class="booking-form-input-box mb-24">
                            <div class="booking-form-input-title">
                                <label asp-for="Address">Street Address</label>
                            </div>
                            <div class="booking-form-input">
                                <input asp-for="Address" type="text" placeholder="House number, street" />
                            </div>
                        </div>

                        <div class="booking-card-grid">
                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="City">City</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="City" type="text" />
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="PostalCode">Postal Code</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="PostalCode" type="text" />
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="Country">Country</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="Country" type="text" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- EMERGENCY CONTACT -->
                    <div class="booking-form-section mb-40">
                        <h5 class="booking-section-title">Emergency Contact</h5>

                        <div class="booking-card-grid">
                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="EmergencyContactName">Contact Name</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="EmergencyContactName" type="text" />
                                </div>
                            </div>

                            <div class="booking-form-input-box">
                                <div class="booking-form-input-title">
                                    <label asp-for="EmergencyContactPhone">Contact Phone</label>
                                </div>
                                <div class="booking-form-input">
                                    <input asp-for="EmergencyContactPhone" type="tel" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SPECIAL REQUESTS -->
                    <div class="booking-form-section mb-40">
                        <h5 class="booking-section-title">Special Requests</h5>

                        <div class="booking-form-input-box">
                            <div class="booking-form-input">
                                <textarea asp-for="SpecialRequests" rows="4"
                                          placeholder="Dietary needs, room sharing, medical conditions, arrival flight details…"></textarea>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="bd-primary-btn btn-style has-arrow is-bg radius-60 w-100 justify-content-center">
                        <span class="bd-primary-btn-arrow arrow-right"><i class="fa-regular fa-arrow-right"></i></span>
                        <span class="bd-primary-btn-text">Confirm Booking</span>
                        <span class="bd-primary-btn-circle"></span>
                        <span class="bd-primary-btn-arrow arrow-left"><i class="fa-regular fa-arrow-right"></i></span>
                    </button>

                </form>
            </div>

            <!-- ============ TOUR SUMMARY SIDEBAR ============ -->
            <div class="col-xxl-4 col-xl-4 col-lg-5 order-1 order-lg-2">
                <aside class="booking-sidebar-wrapper sidebar-sticky">

                    <div class="booking-sidebar-widget-thumb mb-20">
                        <img src="@heroImage" alt="@p.Name" loading="lazy" decoding="async">
                    </div>

                    <h5 class="booking-summary-name mb-5">@p.Name</h5>
                    <div class="booking-item-date mb-20">
                        <span><i class="fa-regular fa-clock"></i></span> @p.DurationDays Days
                        @if (!string.IsNullOrWhiteSpace(p.Destination))
                        {
                            <text> &middot; @p.Destination</text>
                        }
                    </div>

                    <h6 class="booking-section-title">Tour Summary</h6>

                    <div class="booking-sidebar-price-item d-flex justify-content-between">
                        <span>Package</span>
                        <span class="fw-5 text-end">@p.Name</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Destination))
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Destination</span>
                            <span class="fw-5 text-end">@p.Destination</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.Region))
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Region</span>
                            <span class="fw-5 text-end">@p.Region</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.TrekkingType))
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Trip Type</span>
                            <span class="fw-5 text-end">@p.TrekkingType</span>
                        </div>
                    }
                    <div class="booking-sidebar-price-item d-flex justify-content-between">
                        <span>Duration</span>
                        <span class="fw-5 text-end">@p.DurationDays Days</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Difficulty))
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Difficulty</span>
                            <span class="fw-5 text-end">@p.Difficulty</span>
                        </div>
                    }
                    @if (p.MaxAltitudeMeters > 0)
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Max Altitude</span>
                            <span class="fw-5 text-end">@p.MaxAltitudeMeters.ToString("N0") m</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.BestSeason))
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Best Season</span>
                            <span class="fw-5 text-end">@p.BestSeason</span>
                        </div>
                    }

                    <div class="booking-sidebar-divider"></div>

                    <h6 class="booking-section-title">Price Summary</h6>

                    @if (!hasPrice)
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Price</span>
                            <span class="fw-5 text-end">On request</span>
                        </div>
                        <p class="booking-sidebar-note mb-0">
                            Our team will confirm pricing by email once we have your details.
                        </p>
                    }
                    else
                    {
                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>Price Per Person</span>
                            <span class="fw-5" id="pricePerPerson" data-price="@p.Price?.ToString("F2")" data-currency="@currency">
                                @currency @p.Price?.ToString("N0")
                            </span>
                        </div>

                        <div class="booking-sidebar-price-item d-flex justify-content-between">
                            <span>@currency @p.Price?.ToString("N0") &times; <span id="guestCount">@Model.NumberOfTravellers</span></span>
                            <span class="fw-5" id="totalPrice">@currency @((p.Price * Model.NumberOfTravellers)?.ToString("N0"))</span>
                        </div>

                        <div class="booking-sidebar-total d-flex justify-content-between align-items-center">
                            <strong>Total</strong>
                            <strong id="finalPrice">@currency @((p.Price * Model.NumberOfTravellers)?.ToString("N0"))</strong>
                        </div>

                        <p class="booking-sidebar-note mb-0">
                            No payment is taken now. This is a booking request — we will confirm
                            availability and send payment instructions.
                        </p>
                    }

                </aside>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Date pickers: same flatpickr the rest of the site uses. The inputs are type="text"
            // on purpose so the theme input styling applies and every browser gets one calendar.
            if (typeof flatpickr !== "undefined") {
                var base = { dateFormat: "Y-m-d", allowInput: false, disableMobile: true };

                flatpickr("#preferredStartDate", Object.assign({}, base, { minDate: "today" }));

                var maxDob = new Date();
                maxDob.setFullYear(maxDob.getFullYear() - 10);
                flatpickr("#dateOfBirth", Object.assign({}, base, {
                    maxDate: maxDob,
                    defaultDate: null
                }));
            }

            // Live price summary in the sidebar.
            var count = document.getElementById("travellerCount");
            var priceEl = document.getElementById("pricePerPerson");
            if (!count || !priceEl) return;

            var unitPrice = parseFloat(priceEl.getAttribute("data-price"));
            var currency = priceEl.getAttribute("data-currency") || "";
            if (!isFinite(unitPrice)) return;

            var guest = document.getElementById("guestCount");
            var total = document.getElementById("totalPrice");
            var final = document.getElementById("finalPrice");

            function format(value) {
                return currency + " " + value.toLocaleString(undefined, { maximumFractionDigits: 0 });
            }

            function update() {
                var n = parseInt(count.value, 10);
                if (!isFinite(n) || n < 1) n = 1;

                if (guest) guest.textContent = n;
                if (total) total.textContent = format(unitPrice * n);
                if (final) final.textContent = format(unitPrice * n);
            }

            count.addEventListener("input", update);
            count.addEventListener("change", update);
        })();
    </script>
}
