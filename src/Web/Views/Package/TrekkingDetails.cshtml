    <div class="upload-wrapper">
        <label for="ProfileImage" class="upload-box">
            <div class="upload-content">
                <div class="upload-icon">
                    <i class="fa fa-image"></i>
                </div>
                <div class="upload-text">
                    <span class="upload-title">Choose profile</span>
                    <span class="upload-file-name" id="fileName">No file chosen</span>
                </div>
            </div>
        </label>

        <input id="ProfileImage"
               name="ProfileImage"
