               accept=".jpg,.jpeg,.png,.webp"
               class="d-none"
               onchange="document.getElementById('fileName').innerText = this.files.length ? this.files[0].name : 'No file chosen';" />

        <small class="upload-note">Accepted formats: .jpg, .jpeg, .png, .webp</small>
