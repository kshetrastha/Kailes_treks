@using TravelCleanArch.Application.Abstractions.Travel
@model TrekkingDetailsDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = Model.Name;
    var inclusions = Model.CostItems.Where(x => x.Type == "Inclusion").ToList();
    var exclusions = Model.CostItems.Where(x => x.Type == "Exclusion").ToList();
    var mediaItems = Model.MediaItems.OrderBy(x => x.Ordering).ToList();
    var galleryImages = mediaItems
        .Where(x => string.Equals(x.MediaType, "image", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var videoItems = mediaItems
        .Where(x => string.Equals(x.MediaType, "video", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var approvedReviews = Model.Reviews
        .Where(x => string.Equals(x.ModerationStatus, "approved", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var itineraryDays = Model.Itineraries
        .OrderBy(x => x.SortOrder)
        .SelectMany(x => x.Days)
        .OrderBy(x => x.DayNumber)
        .ToList();
}
<div class="section-space-top"></div>
<!-- breadcrumb area start -->
<section class="bd-breadcrumb-area style-two theme-bg-secondary">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-12">
                <div class="bd-breadcrumb-wrapper">
                    <div class="bd-breadcrumb-content">
                        <h1 class="bd-breadcrumb-title">
                            @Model.Name
                        </h1>
                                
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- breadcrumb area end -->


     <section class="bd-tour-details-area section-space">
            <div class="container">
                <div class="row gy-24">
                    <div class="col-xxl-8 col-xl-8 col-lg-7">
                        <div class="tour-details-wrapper">
                            <div class="tour-details mb-25">
                                <div class="tour-details-thumb details-slide-full mb-30">
                                    <img src="@Model.HeroImageUrl" alt="@Model.Name" loading="lazy" decoding="async">
                                </div>
                                <div class="tour-details-content">
                                    <div class="tour-details-badge d-flex gap--5 mb-10">
                                        @if (Model.Featured)
                                        {
                                            <span class="bd-badge warning fw-5">Featured</span>
                                        }

                                        @* <span class="bd-badge danger fw-5">15% Off</span> *@
                                    </div>
                                    <h3 class="tour-details-title mb-15">@Html.Raw(Model.ShortDescription)
                                    </h3>
                                    <div class="tour-details-meta d-flex flex-wrap gap-10 align-items-center justify-content-between mb-20">
                                        <div class="tour-details-price">
                                            <h4 class="price-title">@(Model.PriceOnRequest ? "Price on request" : $"{Model.CurrencyCode ?? "$"} {Model.Price:0.##}")<span>/Per Person</span></h4>
                                        </div>
                                        <div class="tour-details-meta-right d-flex flex-wrap gap-10 align-items-center justify-content-between">
                                            <div class="rating-badge border-badge"><span><i
                                                        class="icon-star"></i>4.4</span></div>
                                            <div class="theme-social">
                                                <a href="#"><i class="icon-facebook"></i></a>
                                                <a href="#"><i class="icon-twitter-x"></i></a>
                                                <a href="#"><i class="icon-linkedin"></i></a>
                                                <a href="#"><i class="icon-youtube"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tour-details-destination-wrapper">
                                        
                                        <div class="tour-details-destination-info">
                                            <div class="search-icon-bg is-big">
                                                <span><i class="fa-light fa-clock"></i></span>
                                            </div>
                                            <div class="tour-details-destination-info-title">
                                                <p class="tour-details-destination-info-top mb-0">Duration</p>
                                                <span class="tour-details-destination-info-bottom small">@Model.DurationDays Days</span>
                                            </div>
                                        </div>
                                        <div class="tour-details-destination-info">
                                            <div class="search-icon-bg is-big">
                                                <span><i class="fa-light fa-mountain"></i></span>
                                            </div>
                                            <div class="tour-details-destination-info-title">
                                                <p class="tour-details-destination-info-top mb-0">Max Elevation</p>
                                                <span class="tour-details-destination-info-bottom small">@Model.MaxAltitudeMeters m@(Model.MaxAltitudeFeet.HasValue ? $" ({Model.MaxAltitudeFeet} ft)" : string.Empty)</span>
                                            </div>
                                        </div>
                                        <div class="tour-details-destination-info">
                                            <div class="search-icon-bg is-big">
                                                <span><i class="fa-light fa-person-hiking"></i></span>
                                            </div>
                                            <div class="tour-details-destination-info-title">
                                                <p class="tour-details-destination-info-top mb-0">Tour Type</p>
                                                <span class="tour-details-destination-info-bottom small">@Model.Difficulty</span>
                                            </div>
                                        </div>
                                        <div class="tour-details-destination-info">
                                            <div class="search-icon-bg is-big">
                                                <span><i class="fa-light fa-location-dot"></i></span>
                                            </div>
                                            <div class="tour-details-destination-info-title">
                                                <p class="tour-details-destination-info-top mb-0">Location</p>
                                                <span class="tour-details-destination-info-bottom">@Model.Destination</span>
                                            </div>
                                        </div>
                                        <div class="tour-details-destination-info">
                                            <div class="search-icon-bg is-big">
                                                <span><i class="fa-light fa-calendar"></i></span>
                                            </div>
                                            <div class="tour-details-destination-info-title">
                                                <p class="tour-details-destination-info-top mb-0">Best Time to Visit</p>
                                                <span class="tour-details-destination-info-bottom">@(string.IsNullOrWhiteSpace(Model.BestSeason) ? "All season" : Model.BestSeason)</span>
                                            </div>
                                        </div>
                                        <div class="tour-details-destination-info">
                                            <div class="search-icon-bg is-big">
                                                <span><i class="fa-light fa-calendar-check"></i></span>
                                            </div>
                                            <div class="tour-details-destination-info-title">
                                                <p class="tour-details-destination-info-top mb-0">Fixed Departure Date</p>
                                                <span class="tour-details-destination-info-bottom small">
                                                    <a href="javascript:void(0)" class="text-decoration-underline">Click Here</a>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                   @if (Model.Highlights.Any())
                            {
                                             <!-- Trip highlights -->
                                     <div class="tour-details-list-wrap mb-35">
                                            <h5 class="mb-20">Trip Highlights</h5>
                                            <div class="tour-details-list-include">
                                                 <ul>
                                                     @foreach (var hi in Model.Highlights)
                                                     {
                                                         <li>
                                                             <span class="list-icon success">
                                                                 <i class="fa-solid fa-check"></i>
                                                                 </span> @hi.Text
                                                         </li>
                                                     }

                                                   
                                                    
                                                </ul>           
                                            </div>
                                        </div>
                                     <!-- Trip highlights Ends -->
                            }
                       

                                    <div class="tour-details-nav-tabs mb-35">
                                        <nav>
                                            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                                <button class="nav-link active" id="nav-overview-tab" data-bs-toggle="tab" data-bs-target="#nav-overview" type="button" role="tab" aria-controls="nav-overview" aria-selected="true">Overview</button>
                                                <button class="nav-link" id="nav-gallery-tab" data-bs-toggle="tab" data-bs-target="#nav-gallery" type="button" role="tab" aria-controls="nav-gallery" aria-selected="false">Gallery</button>
                                                <button class="nav-link" id="nav-feedback-tab" data-bs-toggle="tab" data-bs-target="#nav-feedback" type="button" role="tab" aria-controls="nav-feedback" aria-selected="false">Feedbacks</button>
                                                <button class="nav-link" id="nav-gear-list-tab" data-bs-toggle="tab" data-bs-target="#nav-gear-list" type="button" role="tab" aria-controls="nav-gear-list" aria-selected="false">Gear List</button>
                                            </div>
                                        </nav>
                                        <div class="tab-content" id="nav-tabContent">
                                            <div class="tab-pane fade show active" id="nav-overview" role="tabpanel" aria-labelledby="nav-overview-tab" tabindex="0">
                                               @Html.Raw(Model.Overview)
                                                <div class="tour-details-list-wrap mb-35">
                                                    <h5 class="mb-20">Include/ Exclude</h5>
                                                    <div class="tour-details-list-box">
                                                        <div class="tour-details-list-include">
                                                            <ul>
                                                                @foreach (var inc in inclusions)
                                                                {
                                                            
                                                                <li>
                                                                    <span class="list-icon success">
                                                      <i class="fa-solid fa-check"></i>
                                                    </span> @inc.Title
                                                                </li>
                                                        }                                                  
                                                            </ul>
                                                        </div>
                                                        <div class="tour-details-list-exclude">
                                                            <ul>
                                                        @foreach (var exc in exclusions)
                                                        {
                                                            <li>
                                                                <span class="list-icon danger">
                                                                    <i class="fa-regular fa-xmark"></i>
                                                                </span> @exc.Title
                                                            </li>
                                                           
                                                        }
                                                    </ul>
                                                        </div>
                                                    </div>
                                                </div>
<div class="tour-details-faq mb-35">
<h5 class="mb-20">Day-to-day Brief Itinerary</h5>
<div class="accordion-wrapper faq-style-3">
<div class="accordion" id="accordionExampleThree">
    @if (itineraryDays.Any())
    {
        @for (var i = 0; i < itineraryDays.Count; i++)
        {
            var day = itineraryDays[i];
            var collapseId = $"itinerary-day-{day.Id}";
            var isFirstDay = i == 0;
            <div class="accordion-item">
                <h6 class="accordion-header">
                    <button class="accordion-button @(isFirstDay ? string.Empty : "collapsed")"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="@isFirstDay.ToString().ToLowerInvariant()">
                        <span>Day @day.DayNumber.ToString("00"):</span> @day.ShortDescription
                    </button>
                </h6>
                <div id="@collapseId" class="accordion-collapse collapse @(isFirstDay ? "show" : string.Empty)" data-bs-parent="#accordionExampleThree">
                    <div class="accordion-body">
                        <div class="tour-meta">
                            @if (!string.IsNullOrWhiteSpace(day.Meals))
                            {
                                <span><i class="fa fa-utensils"></i> Meals: @day.Meals</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(day.AccommodationType))
                            {
                                <span><i class="fa fa-bed"></i> Accommodation: @day.AccommodationType</span>
                            }
                        </div>
                        @Html.Raw(day.Description)
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="mb-0">Detailed itinerary will be available soon.</p>
    }















</div>
</div>
</div>
                                            </div>
                                            <div class="tab-pane fade" id="nav-gallery" role="tabpanel" aria-labelledby="nav-gallery-tab" tabindex="0">
                                                <div class="tour-details-gallery mb-35">
                                                    <h5 class="mb-20">Tour Gallery</h5>
                                                    @if (!galleryImages.Any())
                                                    {
                                                        <p class="mb-0">Gallery images will be available soon.</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="row gy-24">
                                                            @foreach (var image in galleryImages)
                                                            {
                                                                <div class="col-xxl-4 col-xl-4 col-lg-6 col-md-6">
                                                                    <div class="tour-details-gallery-thumb image-hover-effect-two position-relative">
                                                                        <img src="@image.Url" alt="@(string.IsNullOrWhiteSpace(image.Caption) ? Model.Name : image.Caption)" loading="lazy" decoding="async">
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(image.Caption))
                                                                    {
                                                                        <p class="mt-10 mb-0">@image.Caption</p>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                @if (videoItems.Any())
                                                {
                                                    <div class="tour-details-location mb-35">
                                                        <h5 class="mb-20">Videos</h5>
                                                        <div class="tour-details-list-include">
                                                            <ul>
                                                                @foreach (var video in videoItems)
                                                                {
                                                                    var videoUrl = string.IsNullOrWhiteSpace(video.VideoUrl) ? video.Url : video.VideoUrl;
                                                                    <li>
                                                                        <span class="list-icon success">
                                                                            <i class="fa-solid fa-video"></i>
                                                                        </span>
                                                                        <a href="@videoUrl" target="_blank" rel="noopener">
                                                                            @(string.IsNullOrWhiteSpace(video.Caption) ? "Watch video" : video.Caption)
                                                                        </a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="tab-pane fade" id="nav-feedback" role="tabpanel" aria-labelledby="nav-feedback-tab" tabindex="0">
                                                <div class="tour-details-rating-wrapper mb-35">
                                                    <div class="row gy-24 align-items-center">
                                                        <div class="col-xl-3 col-lg-4 col-md-4 col-sm-4">
                                                            <div class="rating-box">
                                                                <div class="inner">
                                                                    <div class="rating-number">@((Model.AverageRating ?? 0).ToString("0.0"))</div>
                                                                    <div class="rating">
                                                                        @{
                                                                            var averageRounded = (int)Math.Round(Model.AverageRating ?? 0);
                                                                        }
                                                                        @for (var i = 1; i <= 5; i++)
                                                                        {
                                                                            <a href="#"><i class="fa @(i <= averageRounded ? "fa-star" : "fa-star-o")"></i></a>
                                                                        }
                                                                    </div>
                                                                    <span class="sub-title">(@(Model.ReviewCount ?? approvedReviews.Count) Review)</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-9 col-lg-12 col-md-8 col-sm-12">
                                                            <div class="review-wrapper">
                                                                @for (var star = 5; star >= 1; star--)
                                                                {
                                                                    var count = approvedReviews.Count(x => x.Rating == star);
                                                                    var total = approvedReviews.Count;
                                                                    var percent = total == 0 ? 0 : (int)Math.Round((count * 100.0) / total);
                                                                    <div class="single-progress-bar">
                                                                        <div class="rating-text">@star</div>
                                                                        <div class="progress">
                                                                            <div class="progress-bar bg-1" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                                                        </div>
                                                                        <span class="value-text">@percent%</span>
                                                                        <span class="number">@count</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="tour-details-rating-wrapper">
                                                    @if (!approvedReviews.Any())
                                                    {
                                                        <p class="mb-0">No feedbacks available yet.</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="rewiew-content">
                                                            @foreach (var review in approvedReviews)
                                                            {
                                                                <div class="tour-review-wrapper">
                                                                    <div class="media">
                                                                        <div class="thumbnail">
                                                                            <img src="@(string.IsNullOrWhiteSpace(review.UserPhotoPath) ? Url.Content("~/assets/images/logo-icon.png") : review.UserPhotoPath)"
                                                                                 alt="@review.FullName">
                                                                        </div>
                                                                        <div class="media-body">
                                                                            <h6 class="title">@review.FullName</h6>
                                                                            <div class="rating">
                                                                                @for (var i = 1; i <= 5; i++)
                                                                                {
                                                                                    <a href="#"><i class="fa @(i <= review.Rating ? "fa-star" : "fa-star-o")"></i></a>
                                                                                }
                                                                            </div>
                                                                            <p>@review.ReviewText</p>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="tab-pane fade" id="nav-gear-list" role="tabpanel" aria-labelledby="nav-gear-list-tab" tabindex="0">
                                                <div class="tour-details-gear-list mb-35">
                                                    <h5 class="mb-20">Tour Gear List</h5>
                                                    @if (!Model.GearLists.Any())
                                                    {
                                                        <p class="mb-0">No gear list available yet.</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="row gy-24">
                                                            @foreach (var gear in Model.GearLists.OrderBy(x => x.Id))
                                                            {
                                                                <div class="col-lg-6">
                                                                    <a href="@gear.FilePath" target="_blank" rel="noopener" class="d-block border rounded p-3 h-100">
                                                                        @if (!string.IsNullOrWhiteSpace(gear.ImagePath))
                                                                        {
                                                                            <img src="@gear.ImagePath" alt="Gear list image" class="w-100 mb-3" />
                                                                        }
                                                                        <h6 class="mb-1">@(string.IsNullOrWhiteSpace(gear.ShortDescription) ? "Download Gear List" : gear.ShortDescription)</h6>
                                                                        <small class="text-primary">Open file</small>
                                                                    </a>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
             
                </div>
            </div>
        </section>
