@using TravelCleanArch.Application.Abstractions.Travel
@model TrekkingPagedResult

@{
    ViewData["Title"] = "Tour Listing";
    var location = ViewBag.Location as string;
    var tourType = ViewBag.TourType as string;
    var search = ViewBag.Search as string;
    var trekkingTypeFiltersJson = System.Text.Json.JsonSerializer.Serialize(Model.TrekkingTypeFilters ?? []);
}

<main class="main-area fix">
    <div class="section-space-top"></div>

    <section class="bd-breadcrumb-area p-relative fix">
        <div class="bd-breadcrumb-bg" data-background="cusassests/images/bg/breadcrumb-bg.png"></div>
        <div class="bd-breadcrumb-wrapper p-relative">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-10">
                        <div class="bd-breadcrumb d-flex align-items-center justify-content-center">
                            <div class="bd-breadcrumb-content text-center">
                                <h1 class="bd-breadcrumb-title">Tour Listing</h1>
                                <div class="bd-breadcrumb-list">
                                    <span>
                                        <a asp-controller="Home" asp-action="Index">
                                            <i class="icon-home"></i>Home
                                        </a>
                                    </span>
                                    <span>Tour Listing</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="bd-tour-search-wrapper tour-search-top">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xxl-10 col-xl-10 col-lg-11">

                    <form method="get"
                          asp-action="Index"
                          class="banner-search-wrapper style-two w-100"
                          id="package-search-form">

                        <div class="banner-search-box box-shadow">
                            <div class="banner-search-form">

                                <!-- Location -->
                                <div class="banner-search-field has-separator d-flex align-items-center gap-10">
                                    <div class="search-icon-bg">
                                        <span><i class="fa-regular fa-location-dot"></i></span>
                                    </div>

                                    <div class="banner-search-item banner-select">
                                        <p class="b2 mb-0 fw-5">Where to</p>
                                        <div class="banner-search-select">
                                            <select name="destination" id="destination">
                                                <option value="">Search location</option>

                                                @if (Model.Locations != null)
                                                {
                                                    foreach (var item in Model.Locations)
                                                    {
                                                        <option value="@item.Value"
                                                                selected="@(string.Equals(location, item.Value, StringComparison.OrdinalIgnoreCase))">
                                                            @item.Text
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Search -->
                                <div class="banner-search-field has-separator d-flex align-items-center gap-10">
                                    <div class="search-icon-bg">
                                        <span><i class="fa-regular fa-magnifying-glass"></i></span>
                                    </div>

                                    <div class="banner-search-item">
                                        <p class="b2 mb-0 fw-5">Search</p>
                                        <div class="banner-form-input">
                                            <input class="form-control"
                                                   type="text"
                                                   name="search"
                                                   id="search"
                                                   value="@search"
                                                   placeholder="Search package" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Tour Type -->
                                <div class="banner-search-field d-flex align-items-center gap-10">
                                    <div class="search-icon-bg">
                                        <span><i class="fa-regular fa-location-dot"></i></span>
                                    </div>

                                    <div class="banner-search-item banner-select">
                                        <p class="b2 mb-0 fw-5">Tour Types</p>
                                        <div class="banner-search-select">
                                            <select name="tourType" id="tourType">
                                                <option value="">All Types</option>

                                                @if (Model.TrekkingTypes != null)
                                                {
                                                    foreach (var item in Model.TrekkingTypes)
                                                    {
                                                        <option value="@item.Value"
                                                                selected="@(string.Equals(tourType, item.Value, StringComparison.OrdinalIgnoreCase))">
                                                            @item.Text
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="banner-search-button">
                                <button type="submit" class="banner-btn banner-square-btn bd-btn btn-style radius-10">
                                    <span><i class="fa-regular fa-magnifying-glass"></i></span> Search
                                </button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <section class="bd-tour-listing-area section-space">
        <div class="container" id="package-listing-results">
            <partial name="_PackageListingResults" model="Model" />
        </div>
    </section>
</main>

@section Scripts {
    <script>
        $(function () {
            const $form = $('#package-search-form');
            const $results = $('#package-listing-results');
            const $destination = $('#destination');
            const $tourType = $('#tourType');
            const trekkingTypeFilters = @Html.Raw(trekkingTypeFiltersJson);
            const selectedTourType = '@(tourType ?? string.Empty)';

            function initializeNiceSelect() {
                if (!$.fn.niceSelect) {
                    return;
                }

                if ($destination.next('.nice-select').length === 0) {
                    $destination.niceSelect();
                } else {
                    $destination.niceSelect('update');
                }

                if ($tourType.next('.nice-select').length === 0) {
                    $tourType.niceSelect();
                } else {
                    $tourType.niceSelect('update');
                }
            }

            function updateTourTypeOptions() {
                const destination = ($destination.val() || '').toString();
                const currentSelection = ($tourType.val() || '').toString();

                $tourType.empty().append('<option value="">All Types</option>');

                const matchingTypes = trekkingTypeFilters.filter(function (item) {
                    if (!destination) {
                        return true;
                    }

                    return item.Country && item.Country.toLowerCase() === destination.toLowerCase();
                });

                matchingTypes.forEach(function (item) {
                    const isSelected = item.Value === currentSelection || (!currentSelection && item.Value === selectedTourType);
                    const option = new Option(item.Text, item.Value, false, isSelected);
                    $tourType.append(option);
                });

                if (currentSelection && !matchingTypes.some(function (item) { return item.Value === currentSelection; })) {
                    $tourType.val('');
                }

                initializeNiceSelect();
            }

            initializeNiceSelect();
            updateTourTypeOptions();

            $destination.on('change', function () {
                updateTourTypeOptions();
            });

            function buildUrl() {
                const destination = ($destination.val() || '').toString();
                const search = ($('#search').val() || '').toString();
                const tourType = ($tourType.val() || '').toString();

                const params = [];

                if (destination) params.push('destination=' + encodeURIComponent(destination));
                if (search) params.push('search=' + encodeURIComponent(search));
                if (tourType) params.push('tourType=' + encodeURIComponent(tourType));

                params.push('page=1');

                return window.location.pathname + '?' + params.join('&');
            }

            function loadResults(url, pushState) {
                const ajaxUrl = url + (url.includes('?') ? '&' : '?') + 'partial=true';

                $.ajax({
                    url: ajaxUrl,
                    type: 'GET',
                    success: function (html) {

                        $results.html(html);

                        bindPagination();

                        if (pushState) {
                            history.pushState({}, '', url);
                        }
                    },
                    error: function () {
                        window.location.href = url;
                    }
                });
            }

            function bindPagination() {
                $('.basic-pagination a').off('click').on('click', function (e) {
                    e.preventDefault();
                    loadResults($(this).attr('href'), true);
                });
            }

            // FORM SUBMIT
            $form.on('submit', function (e) {
                e.preventDefault();

                const url = buildUrl();
                loadResults(url, true);
            });

            // BACK BUTTON SUPPORT
            $(window).on('popstate', function () {
                loadResults(window.location.href, false);
            });

            bindPagination();
        });
    </script>
}
