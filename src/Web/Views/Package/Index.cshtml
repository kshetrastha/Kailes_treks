@using TravelCleanArch.Application.Abstractions.Travel
@model TrekkingPagedResult
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Tour Listing";
    var location = ViewBag.Location as string;
    var tourType = ViewBag.TourType as string;
    var search = ViewBag.Search as string;
    var currentPage = Model?.Page ?? 1;
    var pageSize = Model?.PageSize ?? 12;
    var totalCount = Model?.TotalCount ?? 0;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<main class="main-area fix">
    <div class="section-space-top"></div>

    <section class="bd-breadcrumb-area p-relative fix">
        <div class="bd-breadcrumb-bg" data-background="cusassests/images/bg/breadcrumb-bg.png"></div>
        <div class="bd-breadcrumb-wrapper p-relative">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-10">
                        <div class="bd-breadcrumb d-flex align-items-center justify-content-center">
                            <div class="bd-breadcrumb-content text-center">
                                <h1 class="bd-breadcrumb-title">Tour Listing</h1>
                                <div class="bd-breadcrumb-list">
                                    <span><a asp-controller="Home" asp-action="Index"><i class="icon-home"></i>Home</a></span>
                                    <span>Tour Listing</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="bd-tour-search-wrapper tour-search-top">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xxl-10 col-xl-10 col-lg-11">
                    <form method="get" asp-action="Index" class="banner-search-wrapper style-two w-100">
                        <div class="banner-search-box box-shadow">
                            <div class="banner-search-form">
                                <div class="banner-search-field has-separator d-flex align-items-center gap-10">
                                    <div class="search-icon-bg"><span><i class="fa-regular fa-location-dot"></i></span></div>


                                    <div class="banner-search-item banner-select">
                                        <p class="b2 mb-0 fw-5">Where to</p>
                                        <div class="banner-search-select">
                                            <select name="location" id="location">
                                                <option value="">Search location</option>
                                                <option value="Nepal" selected="@(location == "Nepal")">Nepal</option>
                                                <option value="India" selected="@(location == "India")">India</option>
                                                <option value="Bhutan" selected="@(location == "Bhutan")">Bhutan</option>
                                                <option value="China" selected="@(location == "China")">China</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="banner-search-field has-separator d-flex align-items-center gap-10">
                                    <div class="search-icon-bg"><span><i class="icon-cleander"></i></span></div>
                                    <div class="banner-search-item">
                                        <p class="b2 mb-0 fw-5">Search</p>
                                        <div class="banner-form-input">
                                            <input class="form-control" type="text" name="search" value="@search" placeholder="Search package" />
                                        </div>
                                    </div>
                                </div>

                                <div class="banner-search-field d-flex align-items-center gap-10">
                                    <div class="search-icon-bg"><span><i class="fa-regular fa-location-dot"></i></span></div>
                                    <div class="banner-search-item banner-select">
                                        <p class="b2 mb-0 fw-5">Tour Types</p>
                                        <div class="banner-search-select">
                                            <select name="tourType">
                                                <option value="">All Types</option>
                                                <option value="Pilgrimage" selected="@(tourType == "Pilgrimage")">Pilgrimage</option>
                                                <option value="Discovery" selected="@(tourType == "Discovery")">Discovery</option>
                                                <option value="Adventure" selected="@(tourType == "Adventure")">Adventure</option>
                                                <option value="Mountain" selected="@(tourType == "Mountain")">Mountain</option>
                                                <option value="Wildlife" selected="@(tourType == "Wildlife")">Wildlife</option>
                                                <option value="Forest" selected="@(tourType == "Forest")">Forest</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="banner-search-button">
                                <button type="submit" class="banner-btn banner-square-btn bd-btn btn-style radius-10">
                                    <span><i class="fa-regular fa-magnifying-glass"></i></span> Search
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <section class="bd-tour-listing-area section-space">
        <div class="container">
            <div class="row gy-24">
                @if (Model.Items.Any())
                {
                    @foreach (var package in Model.Items)
                    {
                        <div class="col-xxl-3 col-xl-3 col-lg-4 col-md-6">
                            <div class="tour-wrapper style-one">
                                <div class="p-relative">
                                    <div class="tour-thumb image-overly">
                                        <a asp-controller="Package" asp-action="TrekkingDetails" asp-route-slug="@package.Slug">
                                            <img src="@(string.IsNullOrWhiteSpace(package.HeroImageUrl) ? "assets/images/tour/tour-img-9.png" : package.HeroImageUrl)" alt="@package.Name">
                                        </a>
                                    </div>
                                </div>
                                <div class="tour-content">
                                    <div class="tour-rating d-flex align-items-center gap-10 mb-10">
                                        <div class="tour-rating-icon fs-14 d-flex rating-color">
                                            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                                        </div>
                                        <div class="tour-rating-text"><span>@(package.DifficultyLevel ?? "Top Rated")</span></div>
                                    </div>
                                    <h5 class="tour-title fw-5 underline mb-5">
                                        <a asp-controller="Package" asp-action="TrekkingDetails" asp-route-slug="@package.Slug">@package.Name</a>
                                    </h5>
                                    <span class="tour-price b3">$@package.Price.ToString("N2")</span>
                                    <div class="tour-divider"></div>
                                    <div class="tour-meta d-flex align-items-center justify-content-between">
                                        <div class="time d-flex align-items-center gap--5"><i class="icon-heart"></i><span>@package.DurationDays days</span></div>
                                        <div class="tour-btn">
                                            <a asp-controller="Package" asp-action="TrekkingDetails" asp-route-slug="@package.Slug" class="bd-text-btn style-two">
                                                Book Now
                                                <span class="icon__box">
                                                    <i class="fa-regular fa-arrow-right-long icon__first"></i>
                                                    <i class="fa-regular fa-arrow-right-long icon__second"></i>
                                                </span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <p class="mb-0">No tours found for selected filters.</p>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination-wrapper d-flex justify-content-center">
                    <div class="basic-pagination">
                        <nav>
                            <ul>
                                @for (var i = 1; i <= totalPages; i++)
                                {
                                    <li>
                                        <a class="@(i == currentPage ? "current" : null)"
                                           asp-action="Index"
                                           asp-route-page="@i"
                                           asp-route-location="@location"
                                           asp-route-search="@search"
                                           asp-route-tourType="@tourType">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="bd-cta-area cta-bg fix">
        <div class="container">
            <div class="row gy-24 align-content-end justify-content-between">
                <div class="col-xl-5 col-lg-6">
                    <div class="cta-wrapper style-one">
                        <div class="section-title-wrapper mb-35">
                            <h2 class="section-title small white-text mb-15">Subscribe To Our Mailing List & Stay Up To Date</h2>
                            <p class="white-text">Share the core values and principles that drive your company Emphasize a commitment to customer satisfaction</p>
                            <div class="cta-form mb-50">
                                <form action="#">
                                    <div class="cta-input">
                                        <input type="text" placeholder="Your email">
                                        <button type="submit" class="bd-primary-btn btn-style has-arrow is-bg radius-8">
                                            <span class="bd-primary-btn-arrow arrow-right"><i class="fa-regular fa-arrow-right"></i></span>
                                            <span class="bd-primary-btn-text">Subscribe Now</span>
                                            <span class="bd-primary-btn-circle"></span>
                                            <span class="bd-primary-btn-arrow arrow-left"><i class="fa-regular fa-arrow-right"></i></span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6"><div class="cta-thumb-bg p-relative"></div></div>
            </div>
        </div>
    </section>
</main>
