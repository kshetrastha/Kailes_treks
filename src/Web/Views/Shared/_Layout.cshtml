    <!-- preloader end -->
    <!-- Header area start -->
    <header>
        <div class="header-area header-style header-style-two header-transparent" id="header-sticky">
            <div class="container">
                <div class="header-inner">
                    <div class="header-logo">
                        <a href="/"><img src="~/cusassests/images/logo/logo.png" alt="Logo"></a>
                    </div>
                    <div class="header-menu">
                        <nav class="main-menu main-menu-two" id="mobile-menu">
                            <ul>
                                <li>
                                    <a href="/">Home</a>
                                    
                                </li>
                                @if (nav is not null && nav.Count > 0)
                                {
                                    foreach (var nv in nav)
                                    {
                                        <li class="menu-item-has-children">
                                            <a href="javascript:void(0)">@nv.Country</a>


                                            <ul class="submenu">

                                                @if (nv.TrekkingTypes.Any())
                                                {
                                                    @foreach (var type in nv.TrekkingTypes)
                                                    {
                                                            
                                                        <li class="menu-item-has-children has-arrow">
                                                            <a href="javascript:void(0)">@type.TrekkingTypeName</a>
                                                            @if (type.Regions.Any())
                                                            {
                                                                <ul class="submenu">
                                                                    @foreach (var reg in type.Regions)
                                                                    {
                                                                            
                                                                        <li class="menu-item-has-children has-arrow">
                                                                            <a href="javascript:void(0)">@reg.Region</a>
                                                                            <ul class="submenu">
                                                                                @if (reg.Packages.Any())
                                                                                {
                                                                                    @foreach (var pkg in reg.Packages)
                                                                                    {
                                                                                        <li><a href="@pkg.Slug">@pkg.Name</a></li>
                                                                                    }
                                                                                  
                                                                                }
                                                                            </ul>
                                                                           
                                                                        </li>
                                                                    }

                                                               
                                                                </ul>
                                                            }

                                                            @if (type.PackagesWithoutRegion.Any())
                                                            {
                                                                <ul class="submenu">
                                                                    @foreach (var pkg in type.PackagesWithoutRegion)
                                                                    {
                                                                        <li><a href="/packages/@pkg.Slug">@pkg.Name</a></li>
                                                                    }
                                                                </ul>
                                                            }

                                                        </li>

                                                   
                                                    }

                                                }

                                               
                                            </ul>
                                        </li>
                                    }
                                }
                                <li><a href="/our-blogs">Blogs</a></li>
                                <li><a href="contact.html">Contact</a></li>
                            </ul>
                        </nav>
                    </div>
