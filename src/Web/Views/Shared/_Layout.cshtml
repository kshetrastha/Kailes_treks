@using TravelCleanArch.Application.Abstractions.Persistence
@inject IUnitOfWork unitOfWork
@{
    var nav = await unitOfWork.TrekkingService.GetPublicTrekkingHierarchyAsync(default);
    var navs = await unitOfWork.TrekkingService.GetPublicTrekkingHierarchyAsync(default);
}
