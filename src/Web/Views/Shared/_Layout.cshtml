    <link href="~/cusassests/css/vendor/animate.min.css" rel="stylesheet" />
    <link href="~/cusassests/css/plugins/swiper.min.css" rel="stylesheet" />
    <link href="~/cusassests/css/plugins/flatpickr.min.css" rel="stylesheet" />
