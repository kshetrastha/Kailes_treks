@{
    ViewData["Title"] = "Gallery";
}

<section class="container py-5">
    <h1 class="mb-4">Gallery</h1>
    <p class="mb-4">Highlights from our recent treks and expeditions.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <img src="~/assets/img/mid-banner.png" alt="Expedition highlight" class="img-fluid rounded" />
        </div>
        <div class="col-md-4">
            <img src="~/assets/img/high-altitude-film.png" alt="High altitude trail" class="img-fluid rounded" />
        </div>
        <div class="col-md-4">
            <img src="~/assets/img/skydiving.png" alt="Adventure moment" class="img-fluid rounded" />
        </div>
    </div>
</section>
