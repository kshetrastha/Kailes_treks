        <section class="bd-blog-area section-space">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-6 col-lg-12">
                        <div class="section-title-space">
                            <div class="section-title-wrapper text-center">
                                <span class="section-subtitle mb-10">Our Blog</span>
                                <h2 class="section-title">Blog For Travel Updates</h2>
                            </div>
                        </div>
                    </div>
                </div>
                @if (Model.RecentBlogs.Any())
                {
                    var featuredBlog = Model.RecentBlogs.First();
                    var secondaryBlogs = Model.RecentBlogs.Skip(1).ToList();

                    <div class="row gy-24">
                        <div class="col-xxl-5 col-xl-6 col-lg-6 col-md-12 col-sm-12">
                            <article class="blog-wrapper blog-default blog-style">
                                <div class="blog-thumb image-hover-effect">
                                    <a href="/our-blogs/@featuredBlog.Slug"><img src="@(string.IsNullOrWhiteSpace(featuredBlog.ThumbnailImagePath) ? Url.Content("~/cusassests/images/blog/blog-image-1.png") : Url.Content(featuredBlog.ThumbnailImagePath))" alt="@featuredBlog.Title"></a>
                                </div>
                                <div class="blog-content">
                                    <div class="blog-tag"><span><a href="/our-blogs">Travel</a></span></div>
                                    <div class="blog-meta-list">
                                        <div class="blog-meta-item"><span class="meta-icon"><i class="icon-person"></i></span><span class="meta-text">By Admin</span></div>
                                        <div class="blog-meta-item"><span class="meta-icon"><i class="icon-cleander-check"></i></span><span class="meta-text">@featuredBlog.PublishedOnUtc?.ToString("MMMM dd yyyy")</span></div>
                                    </div>
                                    <h5 class="blog-title mb-25 underline"><a href="/our-blogs/@featuredBlog.Slug">@featuredBlog.Title</a></h5>
                                    <div class="blog-btn"><div class="icon-text-btn p-relative"><a href="/our-blogs/@featuredBlog.Slug"><span>Read More</span></a></div></div>
                                </div>
                            </article>
                        </div>
                        <div class="col-xxl-7 col-xl-6 col-lg-6 col-md-12 col-sm-12">
                            <div class="blog-flex">
                                @foreach (var post in secondaryBlogs)
                                {
                                    <article class="blog-wrapper blog-default blog-style-two">
                                        <div class="blog-thumb image-hover-effect"><a href="/our-blogs/@post.Slug"><img src="@(string.IsNullOrWhiteSpace(post.ThumbnailImagePath) ? Url.Content("~/cusassests/images/blog/blog-image-2.png") : Url.Content(post.ThumbnailImagePath))" alt="@post.Title"></a></div>
                                        <div class="blog-content">
                                            <div class="blog-tag"><span><a href="/our-blogs">Travel</a></span></div>
                                            <div class="blog-meta-list">
                                                <div class="blog-meta-item"><span class="meta-icon"><i class="icon-person"></i></span><span class="meta-text">By Admin</span></div>
                                                <div class="blog-meta-item"><span class="meta-icon"><i class="icon-cleander-check"></i></span><span class="meta-text">@post.PublishedOnUtc?.ToString("MMMM dd yyyy")</span></div>
                                            </div>
                                            <h5 class="blog-title mb-30 underline"><a href="/our-blogs/@post.Slug">@post.Title</a></h5>
                                            <div class="blog-btn"><div class="icon-text-btn p-relative"><a href="/our-blogs/@post.Slug"><span>Read More</span></a></div></div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="row justify-content-center mt-50">
                    <div class="col-lg-2">
                        <div class="bd-blog-btn">
                            <a href="/our-blogs" class="bd-primary-btn btn-style has-arrow radius-60">
                                <span class="bd-primary-btn-arrow arrow-right"><i class="fa-regular fa-arrow-right"></i></span>
                                <span class="bd-primary-btn-text">See All</span>
                                <span class="bd-primary-btn-circle"></span>
                                <span class="bd-primary-btn-arrow arrow-left"><i class="fa-regular fa-arrow-right"></i></span>
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- blog area end -->
