<section class="bd-trip-area section-space flash-white p-relative">
    <div class="container">
        <div class="trip-shape">
            <div class="trip-shape-two">
                <img src="~/cusassests/images/shapes/trip-map.png" alt="shape">
            </div>
            <div class="trip-shape-three">
                <img src="~/cusassests/images/shapes/trip-map-small.png" alt="shape">
            </div>
        </div>

        <div class="row gy-24 align-items-center justify-content-center section-title-space">
            <div class="col-lg-8 col-md-8">
                <div class="section-title-wrapper text-center">
                    <span class="section-subtitle mb-10">Our Trips</span>
                    <h2 class="section-title">Trending Destination</h2>
                </div>
            </div>
        </div>

        @{
            var tourCountByCountry = (Model.TrekkingCountryPackageCountDtos ?? new List<TrekkingCountryPackageCountDto>())
                .GroupBy(x => x.Country)
                .ToDictionary(g => g.Key, g => g.First().PackageCount);

            var trekkingDestinations = (Model.TrekkingCountryGroupDtos ?? new List<TrekkingCountryGroupDto>())
                .SelectMany(countryGroup => countryGroup.TrekkingTypes
                    .SelectMany(typeGroup => typeGroup.Regions.SelectMany(region => region.Packages)
                        .Concat(typeGroup.PackagesWithoutRegion))
                    .Select(pkg => new
                    {
                        Title = pkg.Name,
                        Country = countryGroup.Country.ToString(),
                        ImageUrl = pkg.ImageURL,
                        TourCount = tourCountByCountry.TryGetValue(countryGroup.Country.ToString(), out var count) ? count : 1
                    }))
                .Where(x => !string.IsNullOrWhiteSpace(x.Title))
                .ToList();

            if (!trekkingDestinations.Any())
            {
                trekkingDestinations = (Model.TrekkingCountryPackageCountDtos ?? new List<TrekkingCountryPackageCountDto>())
                    .Select(x => new
                    {
                        Title = x.Country,
                        Country = x.Country,
                        ImageUrl = x.ImageUrl,
                        TourCount = x.PackageCount
                    })
                    .ToList();
            }

            var items = new List<dynamic>();
            if (trekkingDestinations.Any())
            {
                items = Enumerable.Range(0, 6)
                    .Select(i => (dynamic)trekkingDestinations[i % trekkingDestinations.Count])
                    .ToList();
            }
        }

        @if (items.Any())
        {
            <div class="destination-grid">
                @for (int i = 0; i < items.Count; i++)
                {
                    var item = items[i];

                    var imageUrl = !string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? item.ImageUrl
                        : Url.Content("~/cusassests/images/trip/trip-img-1.png");

                    var gridClass = i switch
                    {
                        0 => "destination-card destination-large",
                        1 => "destination-card destination-small",
                        2 => "destination-card destination-wide",
                        _ => "destination-card"
                    };

                    <div class="@gridClass">
                        <div class="trip-wrapper trip-style-one p-relative h-100">
                            <div class="trip-thumb image-overly">
                                <a href="#">
                                    <img src="@imageUrl" alt="@item.Country">
                                </a>
                            </div>

                            <div class="trip-tag">
                                <div class="trip-number">
                                    <span>
                                        <a href="#">@item.TourCount Tours</a>
                                    </span>
                                </div>
                                <div class="trip-location">
                                    <span>
                                        <a href="#">@item.Country</a>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

    
