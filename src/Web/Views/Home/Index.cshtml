@using TravelCleanArch.Domain.Entities
@using TravelCleanArch.Web.Models.Home
@model TravelCleanArch.Web.Models.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";

    var banner = Model.GetBannerContent;
    var aboutUs = Model.WhoWeAreItems?.FirstOrDefault();

    var bgImage = Url.Content("~/cusassests/images/bg/banner-bg.png");

    var subtitle = !string.IsNullOrWhiteSpace(banner?.SubDescription)
        ? banner.SubDescription
        : "You Dream, We Plan";

    var title = !string.IsNullOrWhiteSpace(banner?.Title)
        ? banner.Title
        : "Sacred Journeys to";

    var highlightText = !string.IsNullOrWhiteSpace(banner?.Description)
        ? banner.Description
        : "Kailash & the Himalayas.";
    var images = banner?.Images?.ToList() ?? new List<BannerImage>();

    var mainImage = images.Count > 0 && !string.IsNullOrWhiteSpace(images[0].ImagePath)
        ? Url.Content(images[0].ImagePath)
        : Url.Content("~/cusassests/images/banner/banner-1-img-1.png");

    var secondaryImage = images.Count > 1 && !string.IsNullOrWhiteSpace(images[1].ImagePath)
        ? Url.Content(images[1].ImagePath)
        : Url.Content("~/cusassests/images/banner/banner-1-img-2.png");

    var aboutDesc = !string.IsNullOrWhiteSpace(aboutUs?.Description)
        ? aboutUs.Description
        : @"<div class='section-title-wrapper mb-35'>
                <span class='section-subtitle mb-15'>About Our Company</span>
                <h2 class='section-title mb-20'>Explore the Himalayas with Trusted Experts</h2>
                <p style='text-align: justify;'>
                    Welcome to Visit Kailash Treks Nepal, a professional trekking and tour operator offering unforgettable adventures across Nepal, Tibet, India, and Bhutan. We specialize in organizing Kailash Manasarovar tours, Himalayan trekking, rafting adventures, and spiritual pilgrimage journeys. Our experienced team ensures every trip is safe, comfortable, and perfectly organized for travelers from around the world.
                </p>
            </div>
            <div class='about-feature-list'>
                <ul>
                    <li>
                        <span class='list-icon'><i class='fa-solid fa-check'></i></span>
                        <p>Expert trekking guides and local travel specialists</p>
                    </li>
                    <li>
                        <span class='list-icon'><i class='fa-solid fa-check'></i></span>
                        <p>Kailash Manasarovar and Himalayan pilgrimage tours</p>
                    </li>
                    <li>
                        <span class='list-icon'><i class='fa-solid fa-check'></i></span>
                        <p>Safe, reliable, and well-planned travel experiences</p>
                    </li>
                </ul>
            </div>";

    var abtImages = aboutUs?.Images?.ToList() ?? new List<WhoWeAreImageItemViewModel>();
    var abtmainImage = !string.IsNullOrWhiteSpace(aboutUs?.ImagePath)
        ? Url.Content(aboutUs.ImagePath)
        : Url.Content("~/cusassests/images/about/about-img-1.png");

    var abtsecondaryImage = abtImages.Count > 0 && !string.IsNullOrWhiteSpace(abtImages[0].ImagePath)
        ? Url.Content(abtImages[0].ImagePath)
        : Url.Content("~/cusassests/images/about/about-img-2.png");

}

<!-- Banner area start -->
<section class="banner-area banner-height p-relative z-index-11 image-bg" style="background: url('@bgImage') no-repeat; width: 100%;">
    <div class="banner-shape">
        <div class="banner-shape-one">
            <img src="~/cusassests/images/shapes/circle-bg.png" alt="image">
        </div>
        <div class="banner-shape-two">
            <img src="~/cusassests/images/shapes/sky.png" alt="image">
        </div>
        <div class="banner-shape-three">
            <img src="~/cusassests/images/shapes/circle.png" alt="image">
        </div>
        <div class="banner-shape-four">
            <img src="~/cusassests/images/shapes/circle-bg2.png" alt="image">
        </div>
                
        <div class="banner-shape-eight">
            <img src="~/cusassests/images/shapes/dot-square.png" alt="image">
        </div>
    </div>
    <div class="swiper banner__active overflow-visible p-relative">
        <div class="swiper-wrapper">
            <div class="swiper-slide banner_more_item">
                <div class="container">
                    <div class="row gy-24 align-items-center justify-content-between">
                        <div class="col-xxl-7 col-xl-6 col-lg-6">
                            <div class="mt-50">
                                <div class="banner-content p-relative wow bdFadeInLeft" data-wow-delay=".2s">
                                    <span class="section-subtitle mb-25 wow bdFadeInLeft" data-wow-delay=".3s">@subtitle</span>
                                    <h1 class="banner-title wow bdFadeInLeft" data-wow-delay=".4s">
                                        @title  <span class="yellow-shape">
                                        @Html.Raw(highlightText)
                                        <img src="~/cusassests/images/shapes/yellow-shape.png" alt="yellow-shape">
                                    </span>
                                </h1>
                            </div>
                        </div>
                    </div>
                    <div class="col-xxl-5 col-xl-6 col-lg-6">
                        <div class="banner-thumb-wrapper position-relative wow bdFadeInRight" data-wow-delay=".3s">
                            <div class="banner-thumb-one wow bdFadeInRight" data-wow-delay=".4s">
                                <img src="@mainImage" alt="image">
                            </div>
                            <div class="banner-thumb-two wow bdFadeInRight" data-wow-delay=".5s">
                                <img src="@secondaryImage" alt="image">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- if you active slider then remove "d-none" -->
    <div class="banner-nav-btn banner-one-navigation d-none">
        <div class="banner-pagination">
            <div class="swiper-pagination bd-pagination justify-content-center"></div>
        </div>
        <div class="banner-navigation-btn">
            <button class="Visit Kailash Treks-navigation-prev"><i class="fa-regular fa-angle-left"></i></button>
            <button class="Visit Kailash Treks-navigation-next"><i class="fa-regular fa-angle-right"></i></button>
        </div>
    </div>
</div>
</section>

<!-- Banner area start -->
<section class="section-space work-with">
