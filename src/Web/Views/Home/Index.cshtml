        <iframe id="ytVideo"
                width="100%"
                height="auto"
                src="https://www.youtube.com/embed/onvqFHmDA5Y?autoplay=1&mute=1&controls=0&loop=1&playlist=onvqFHmDA5Y&enablejsapi=1"
                frameborder="0"
                title="YouTube video player"
                allow="autoplay; encrypted-media"
                allowfullscreen>
        </iframe>

        <!-- Mute Button -->
        <button id="muteBtn"
                style="position:absolute; top:10px; z-index: 2; right:10px; padding:8px 12px; background:rgba(0,0,0,0.5); color:#fff; border:none; cursor:pointer;">
            🔇
