									         <!-- testimonial area start -->
        <section class="bd-testimonial-area section-space-bottom section-space-top flash-white p-relative">
            <div class="container">
                <div class="row gy-24 align-items-center text-center justify-content-center section-title-space">
                    <div class="col-xl-6">
                        <div class="section-title-wrapper">
                            <span class="section-subtitle mb-10">Testimonials</span>
                            <h2 class="section-title">Customers Feedback</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-fluid">
                <div class="swiper testimonial-active-two">
                    <div class="swiper-wrapper">
                        @if (Model.Reviews.Any())
                        {
                            foreach (var review in Model.Reviews)
                            {
                                var reviewerImage = string.IsNullOrWhiteSpace(review.ReviewerImagePath)
                                    ? Url.Content("~/cusassests/images/client/01.png")
                                    : Url.Content(review.ReviewerImagePath);
                                var reviewerRole = string.IsNullOrWhiteSpace(review.ReviewerRole) ? "Traveller" : review.ReviewerRole;
                                var rating = Math.Clamp(review.Rating, 1, 5);
                                <div class="swiper-slide">
                                    <div class="testimonial-wrapper testimonial-style-two">
                                        <div class="testimonial-content p-relative">
                                            <div class="testimonial-avatar flex-wrap">
                                                <div class="testimonial-avatar-wrap">
                                                    <div class="avatar-thumb">
                                                        <img src="@reviewerImage" alt="@review.ReviewerName">
                                                    </div>
                                                    <div class="avatar-meta">
                                                        <h6 class="avatar-meta-title">@review.ReviewerName</h6>
                                                        <p>@reviewerRole</p>
                                                    </div>
                                                </div>
                                                <div class="avatar-rating p-relative">
                                                    <div class="fs-14 d-flex rating-color">
                                                        @for (var i = 0; i < rating; i++)
                                                        {
                                                            <i class="fa-solid fa-star"></i>
                                                        }
                                                    </div>
                                                    <div class="testimonial-quot">
                                                        <img src="~/cusassests/images/testimonial/quot-shape-2.png" alt="shape">
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="testimonial-desc">@review.ReviewText</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="slider-pagination-wrapper">
                        <div class="slider-pagination bd-pagination mt-50 justify-content-center"></div>
                    </div>
                </div>
            </div>
        </section>
        <!-- testimonial area start -->



