@using TravelCleanArch.Domain.Entities
@using TravelCleanArch.Application.Abstractions.Travel
@using TravelCleanArch.Web.Models.Home
@model TravelCleanArch.Web.Models.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";

    var banner = Model.GetBannerContent;
    var aboutUs = Model.WhoWeAreItems?.FirstOrDefault();

    var bgImage = Url.Content("~/cusassests/images/bg/banner-bg.png");

    var subtitle = !string.IsNullOrWhiteSpace(banner?.SubDescription)
        ? banner.SubDescription
        : "You Dream, We Plan";

    var title = !string.IsNullOrWhiteSpace(banner?.Title)
        ? banner.Title
        : "Sacred Journeys to";

    var highlightText = !string.IsNullOrWhiteSpace(banner?.Description)
        ? banner.Description
        : "Kailash & the Himalayas.";
    var images = banner?.Images?.ToList() ?? new List<BannerImage>();

    var mainImage = images.Count > 0 && !string.IsNullOrWhiteSpace(images[0].ImagePath)
        ? Url.Content(images[0].ImagePath)
        : Url.Content("~/cusassests/images/banner/banner-1-img-1.png");

    var secondaryImage = images.Count > 1 && !string.IsNullOrWhiteSpace(images[1].ImagePath)
        ? Url.Content(images[1].ImagePath)
        : Url.Content("~/cusassests/images/banner/banner-1-img-2.png");

    var aboutDesc = !string.IsNullOrWhiteSpace(aboutUs?.Description)
        ? aboutUs.Description
        : @"<div class='section-title-wrapper mb-35'>
                <span class='section-subtitle mb-15'>About Our Company</span>
                <h2 class='section-title mb-20'>Explore the Himalayas with Trusted Experts</h2>
                <p style='text-align: justify;'>
                    Welcome to Visit Kailash Treks Nepal, a professional trekking and tour operator offering unforgettable adventures across Nepal, Tibet, India, and Bhutan. We specialize in organizing Kailash Manasarovar tours, Himalayan trekking, rafting adventures, and spiritual pilgrimage journeys. Our experienced team ensures every trip is safe, comfortable, and perfectly organized for travelers from around the world.
                </p>
            </div>
            <div class='about-feature-list'>
                <ul>
                    <li>
                        <span class='list-icon'><i class='fa-solid fa-check'></i></span>
                        <p>Expert trekking guides and local travel specialists</p>
                    </li>
                    <li>
                        <span class='list-icon'><i class='fa-solid fa-check'></i></span>
                        <p>Kailash Manasarovar and Himalayan pilgrimage tours</p>
                    </li>
                    <li>
                        <span class='list-icon'><i class='fa-solid fa-check'></i></span>
                        <p>Safe, reliable, and well-planned travel experiences</p>
                    </li>
                </ul>
            </div>";

    var abtImages = aboutUs?.Images?.ToList() ?? new List<WhoWeAreImageItemViewModel>();
    var abtmainImage = !string.IsNullOrWhiteSpace(aboutUs?.ImagePath)
        ? Url.Content(aboutUs.ImagePath)
        : Url.Content("~/cusassests/images/about/about-img-1.png");

    var abtsecondaryImage = abtImages.Count > 0 && !string.IsNullOrWhiteSpace(abtImages[0].ImagePath)
        ? Url.Content(abtImages[0].ImagePath)
        : Url.Content("~/cusassests/images/about/about-img-2.png");

}
<style>
	.destination-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 170px;
    grid-auto-flow: dense;
    gap: 24px;
}

.destination-card {
    grid-column: span 3;
    grid-row: span 2;
    border-radius: 12px;
    overflow: hidden;
}

.destination-large {
    grid-column: span 4;
    grid-row: span 4;
}

.destination-small {
    grid-column: span 3;
    grid-row: span 2;
}

.destination-wide {
    grid-column: span 5;
    grid-row: span 2;
}

.destination-card .trip-wrapper,
.destination-card .trip-thumb,
.destination-card .trip-thumb a {
    height: 100%;
    width: 100%;
    display: block;
}

.destination-card .trip-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* keep overlay dark like screenshot */
.destination-card .image-overly::before {
    border-radius: 12px;
}

/* location label */
.destination-card .trip-location {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 3;
}

.destination-card .trip-location span a {
    background: #fff;
    color: #001b3f;
    padding: 0px 30px;
    display: inline-block;
    border-radius: 0 10px 0 0;
    font-size: 20px;
    font-weight: 500;
}

/* tour count */
.destination-card .trip-number {
    position: absolute;
    right: 20px;
    top: 20px;
    z-index: 3;
}

.destination-card .trip-number span a {
    background: #fff;
    color: #001b3f;
    padding: 7px 16px;
    display: inline-block;
    border-radius: 30px;
    font-size: 16px;
    font-weight: 500;
}

/* Tablet */
@@media (max-width: 991px) {
    .destination-grid {
        grid-template-columns: repeat(6, 1fr);
        grid-auto-rows: 160px;
    }

    .destination-large,
    .destination-wide,
    .destination-small,
    .destination-card {
        grid-column: span 3;
        grid-row: span 2;
    }
}

/* Mobile */
@@media (max-width: 575px) {
    .destination-grid {
        grid-template-columns: 1fr;
        grid-auto-rows: 260px;
        gap: 20px;
    }

    .destination-large,
    .destination-wide,
    .destination-small,
    .destination-card {
        grid-column: span 1;
        grid-row: span 1;
    }
}
.destination-card .trip-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
</style>
