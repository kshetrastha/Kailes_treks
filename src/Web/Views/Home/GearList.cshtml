@{
    ViewData["Title"] = "Gear List";
}

<section class="container py-5">
    <h1 class="mb-4">Gear List</h1>
    <p class="mb-4">Recommended essentials to prepare for your trip.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <h5>Clothing</h5>
            <ul>
                <li>Base layers (thermal top and bottom)</li>
                <li>Insulated jacket</li>
                <li>Waterproof shell jacket and pants</li>
                <li>Warm hat and gloves</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h5>Equipment</h5>
            <ul>
                <li>Trekking boots</li>
                <li>Day pack (25-35L)</li>
                <li>Reusable water bottles</li>
                <li>Headlamp with spare batteries</li>
            </ul>
        </div>
    </div>
</section>
