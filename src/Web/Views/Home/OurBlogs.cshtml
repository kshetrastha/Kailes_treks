@model TravelCleanArch.Web.Models.Home.BlogListViewModel
@{
    ViewData["Title"] = "Blog List";
}

<section class="bd-breadcrumb-area p-relative fix">
    <div class="bd-breadcrumb-bg" data-background="/cusassests/images/bg/breadcrumb-bg.png"></div>
    <div class="bd-breadcrumb-wrapper p-relative">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <div class="bd-breadcrumb d-flex align-items-center justify-content-center">
                        <div class="bd-breadcrumb-content text-center">
                            <h1 class="bd-breadcrumb-title">Blog List</h1>
                            <div class="bd-breadcrumb-list">
                                <span><a href="/"><i class="icon-home"></i>Home</a></span>
                                <span>Blog List</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-space">
    <div class="bd-blog-list-area">
        <div class="container">
            <div class="row gy-24">
                <div class="col-lg-8 mx-auto">
                    <div class="blog-list">
                        @foreach (var post in Model.OtherPosts)
                        {
                            <div class="blog-list-single-wrapper">
                                <div class="blog-list-thumb mb-25">
                                    <a href="/our-blogs/@post.Slug">
                                        <img src="@(string.IsNullOrWhiteSpace(post.ThumbnailImagePath) ? "/customer/assets/img/hero/hero1.jpg" : $"/{post.ThumbnailImagePath}")"
                                             alt="@post.Title">
                                    </a>
                                </div>
                                <div class="blog-content">
                                    <div class="blog-meta-list mb-15">
                                        <div class="blog-meta-item">
                                            <i class="icon-person"></i> Admin
                                        </div>
                                        <div class="blog-meta-item">
                                            <i class="icon-cleander-check"></i> @post.PublishedOnUtc?.ToString("MMM yyyy")
                                        </div>
                                    </div>

                                    <h4 class="blog-title mb-15">
                                        <a href="/our-blogs/@post.Slug">@post.Title</a>
                                    </h4>

                                    @if (!string.IsNullOrWhiteSpace(post.Summary))
                                    {
                                        <p class="blog-description">@post.Summary</p>
                                    }

                                    <div class="about-btn">
                                        <a href="/our-blogs/@post.Slug" class="bd-primary-btn btn-style has-arrow is-bg radius-60">
                                            <span class="bd-primary-btn-arrow arrow-right"><i class="fa-regular fa-arrow-right"></i></span>
                                            <span class="bd-primary-btn-text">Read More</span>
                                            <span class="bd-primary-btn-circle"></span>
                                            <span class="bd-primary-btn-arrow arrow-left"><i class="fa-regular fa-arrow-right"></i></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="pagination-wrapper">
                        <div class="basic-pagination">
                            <nav>
                                <ul class="page-pagination mb-0 p-0 ">
                                    <li><span aria-label="Page 1" aria-current="page" class="page-numbers current">1</span></li>
                                </ul>
                            </nav>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
