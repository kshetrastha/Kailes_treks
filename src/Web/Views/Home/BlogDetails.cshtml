@model TravelCleanArch.Web.Models.Home.BlogDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="bd-breadcrumb-area p-relative fix">
    <div class="bd-breadcrumb-bg" data-background="@(string.IsNullOrWhiteSpace(Model.HeroImagePath) ? "/customer/assets/img/contact.jpg" : $"/{Model.HeroImagePath}")"></div>
    <div class="bd-breadcrumb-wrapper p-relative">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <div class="bd-breadcrumb d-flex align-items-center justify-content-center">
                        <div class="bd-breadcrumb-content text-center">
                            <h1 class="bd-breadcrumb-title">@Model.Title</h1>
                            <div class="bd-breadcrumb-list">
                                <span><a href="/"><i class="icon-home"></i>Home</a></span>
                                <span>Blog Details</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bd-blog-details-area section-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <article class="post-details mb-50">
                    <div class="post-details-thumb mb-25">
                        <img src="@(string.IsNullOrWhiteSpace(Model.ThumbnailImagePath) ? "/customer/assets/img/contact.jpg" : $"/{Model.ThumbnailImagePath}")" alt="@Model.Title">
                    </div>

                    <div class="post-details-content">
                        <h3 class="post-details-title mb-15">@Model.Title</h3>

                        <div class="post-details-meta mb-20">
                            <ul>
                                <li><i class="icon-person"></i> Admin</li>
                                <li><i class="icon-cleander-check"></i> @Model.PublishedOnUtc?.ToString("MMMM yyyy")</li>
                            </ul>
                        </div>

                        <div class="post-content mb-30">
                            @Html.Raw(Model.ContentHtml)
                        </div>

                        <div class="post-details-tag d-flex justify-content-between flex-wrap">
                            <div class="tagcloud">
                                <a href="#">Kailash</a>
                                <a href="#">Trek</a>
                                <a href="#">Spiritual</a>
                            </div>

                            <div class="theme-social">
                                <a href="#"><i class="fa-brands fa-facebook"></i></a>
                                <a href="#"><i class="fa-brands fa-twitter"></i></a>
                                <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>
