@model TravelCleanArch.Web.Models.Home.MasterFaqPageViewModel
<section class="bd-breadcrumb-area p-relative fix">
    <div class="bd-breadcrumb-bg" data-background="assets/images/bg/breadcrumb-bg.png"></div>
    <div class="bd-breadcrumb-wrapper p-relative"><div class="container"><div class="row justify-content-center"><div class="col-xl-10"><div class="bd-breadcrumb d-flex align-items-center justify-content-center"><div class="bd-breadcrumb-content text-center"><h1 class="bd-breadcrumb-title">Frequently Asked Questions</h1><div class="bd-breadcrumb-list"><span><a href="/"><i class="icon-home"></i>Home</a></span><span>FAQ</span></div></div></div></div></div></div></div>
</section>
<section class="section-space"><div class="container"><div class="row justify-content-center"><div class="col-xl-8"><div class="section-title text-center mb-40"><h2 class="title">Frequently Asked Questions</h2><p>Find answers to common questions about our services, policies, and more.</p></div><div class="accordion-wrapper faq-style-3"><div class="accordion" id="accordion_id">
@for (var i = 0; i < Model.Faqs.Count; i++) { var faq = Model.Faqs[i]; var n = i + 1; var show = i == 0; <div class="accordion-item"><h2 class="accordion-header" id="heading@n"><button class="accordion-button @(show ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@n"><span>Q@n:</span> @faq.Question</button></h2><div id="collapse@n" class="accordion-collapse collapse @(show?"show":"")" data-bs-parent="#accordion_id"><div class="accordion-body">@faq.Answer</div></div></div> }
</div></div></div></div></div></section>
