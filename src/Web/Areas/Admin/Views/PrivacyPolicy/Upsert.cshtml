@model TravelCleanArch.Web.Areas.Admin.Models.PrivacyPolicySectionFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Privacy Policy Section" : "Create Privacy Policy Section";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@(isEdit ? "Edit" : "Create") Privacy Policy Section</h2>
        <a class="btn btn-outline-secondary" href="/admin/company/privacy-policy">Back to list</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="privacyPolicyForm" method="post" action="@(isEdit ? $"/admin/company/privacy-policy/{Model.Id}/edit" : "/admin/company/privacy-policy/create")" novalidate>
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Section Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Information We Collect" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContentHtml" class="form-label">Content</label>
                    <textarea asp-for="ContentHtml" rows="14" class="form-control textEditor"></textarea>
                    <span asp-validation-for="ContentHtml" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Ordering" class="form-label"></label>
                    <input asp-for="Ordering" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Ordering" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsContactBlock" class="form-check-input" />
                    <label asp-for="IsContactBlock" class="form-check-label">Show as contact block (rendered last, in the highlighted box)</label>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary">@(isEdit ? "Update" : "Create")</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
