@model TravelCleanArch.Application.Abstractions.Master.AccomodationPagedResult
@{
    ViewData["Title"] = "Travel - Accomodations";
    var selectedPageSize = ViewBag.PageSize is int value ? value : 20;
    var accomodationName = ViewBag.AccomodationName as string ?? string.Empty;
    var pageSizeOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new("10 Rows/Page", "10", selectedPageSize == 10),
        new("20 Rows/Page", "20", selectedPageSize == 20),
        new("50 Rows/Page", "50", selectedPageSize == 50),
        new("100 Rows/Page", "100", selectedPageSize == 100),
        new("All Rows/Page", "-1", selectedPageSize == -1)
    };
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form id="accomodationFilterForm" method="post" action="/admin/accomodations" class="row">
                @Html.AntiForgeryToken()
                <input type="hidden" id="accomodationPage" name="page" value="@Model.Page" />
                <input type="hidden" id="pageSize" name="pageSize" value="@selectedPageSize" />

                <div class="col-md-3 mt-3 mt-md-0">
                    <label for="accomodationName" class="form-label text-muted">Accomodation Name</label>
                    <input type="text" id="accomodationName" name="accomodationName" value="@accomodationName" class="form-control" placeholder="Search by accomodation name" />
                </div>

                <div class="col-md-3 mt-3 mt-md-0 d-flex align-items-end">
                    <button type="submit" id="btn-search" class="btn btn-primary">
                        <i class="fa fa-search"></i>
                        Search
                    </button>
                    <a href="/admin/accomodations" class="btn btn-outline-secondary ms-2">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row align-items-center mb-3">
                <div class="col-md-6">
                    <a class="btn btn-primary"
                       asp-area="Admin"
                       asp-controller="Accomodations"
                       asp-action="Create">
                        Add New
                    </a>
                </div>

                <div class="col-md-6 d-flex justify-content-md-end align-items-center">
                    <label for="pageSizeTop" class="me-2 mb-0 text-muted">
                        Rows / Page
                    </label>
                    <select id="pageSizeTop"
                            asp-items="pageSizeOptions"
                            class="form-select"
                            style="width:120px;">
                    </select>
                </div>
            </div>

            <partial name="_AccomodationsTable" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("accomodationFilterForm");
            const pageSizeInput = document.getElementById("pageSize");
            const pageSizeSelect = document.getElementById("pageSizeTop");
            const pageInput = document.getElementById("accomodationPage");
            const tableSectionId = "accomodationsTableSection";

            if (!form || !pageSizeInput || !pageSizeSelect || !pageInput) {
                return;
            }

            pageSizeSelect.value = pageSizeInput.value;

            async function postTable() {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!response.ok) {
                    form.submit();
                    return;
                }

                const html = await response.text();
                const tableSection = document.getElementById(tableSectionId);
                if (!tableSection) {
                    form.submit();
                    return;
                }

                tableSection.outerHTML = html;
            }

            pageSizeSelect.addEventListener("change", () => {
                pageSizeInput.value = pageSizeSelect.value;
                pageInput.value = "1";
                postTable();
            });

            form.addEventListener("submit", (event) => {
                event.preventDefault();
                pageInput.value = "1";
                postTable();
            });

            document.addEventListener("click", (event) => {
                const pageButton = event.target.closest(`#${tableSectionId} .js-accomodations-page`);
                if (!pageButton) {
                    return;
                }

                event.preventDefault();
                pageInput.value = pageButton.dataset.page || "1";
                postTable();
            });
        })();
    </script>
}
