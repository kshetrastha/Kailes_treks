@model IReadOnlyList<TravelCleanArch.Domain.Entities.TrekkingInquiry>
@{
    ViewData["Title"] = "Trekking Inquiries";
}
<div class="card">
    <div class="card-body">
        <h4 class="card-title mb-3">Trekking Inquiries</h4>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Package</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Comment</th>
                        <th>Submitted (UTC)</th>
                        <th>Source</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No trekking inquiries submitted yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Trekking?.Name ?? $"Trekking #{item.TrekkingId}")</td>
                            <td>@item.FullName</td>
                            <td><a href="mailto:@item.EmailAddress">@item.EmailAddress</a></td>
                            <td style="max-width: 360px; white-space: pre-wrap;">@item.Comment</td>
                            <td>@item.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.SourcePage</td>
                            <td>@item.IpAddress</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
