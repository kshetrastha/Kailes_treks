@model TravelCleanArch.Web.Areas.Admin.Models.BannerFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Banner" : "Create Banner";
}
<style>
    .cropper-container {
        width: 668px;
        height: 631px !important;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@(isEdit ? "Edit" : "Create") Banner</h2>
        <a class="btn btn-outline-secondary" href="/admin/company/banners">Back to list</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" action="@(isEdit ? $"/admin/company/banners/{Model.Id}/edit" : "/admin/company/banners/create")">
                @Html.AntiForgeryToken()
                @if (isEdit) { <input type="hidden" asp-for="Id" /> }

                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                    <div class="col-md-3"><label asp-for="Ordering" class="form-label"></label><input asp-for="Ordering" class="form-control" /><span asp-validation-for="Ordering" class="text-danger"></span></div>
                    <div class="col-md-3 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div></div>
                    <div class="col-md-6"><label asp-for="SubDescription" class="form-label">Sub Description</label><input asp-for="SubDescription" class="form-control" /><span asp-validation-for="SubDescription" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Banner Images</h5>
                    <button type="button" id="addBannerImage" class="btn btn-sm btn-outline-secondary">Add image</button>
                </div>



                <div id="bannerImagesWrap" class="d-grid gap-2">
                    @for (var i = 0; i < Model.Images.Count; i++)
                    {
                        <div class="row g-2 border rounded p-2 banner-image-item">
                            <input type="hidden" name="Images[@i].Id" value="@Model.Images[i].Id" />
                            <input type="hidden" name="Images[@i].ExistingImagePath" value="@Model.Images[i].ExistingImagePath" />
                            <div class="col-md-3">
                                <input type="file"
                                       name="Images[@i].Image"
                                       class="form-control js-crop-image"
                                       accept="image/*"
                                       data-aspect-ratio="0.5793939394"
                                       data-crop-width="478"
                                       data-crop-height="825" />
                                <small class="text-muted">Image opens Cropper.js before upload (478:825 portrait).</small>
                                @if (!string.IsNullOrWhiteSpace(Model.Images[i].ExistingImagePath))
                                {
                                    <img src="/@Model.Images[i].ExistingImagePath" alt="Banner image" class="img-thumbnail mt-2" style="max-height:90px; object-fit:cover;" />
                                }
                            </div>
                            <div class="col-md-2"><input name="Images[@i].SubDescription" value="@Model.Images[i].SubDescription" class="form-control" placeholder="Sub description" /></div>
                            <div class="col-md-3"><input name="Images[@i].Description" value="@Model.Images[i].Description" class="form-control" placeholder="Description" /></div>
                            <div class="col-md-1"><input name="Images[@i].Ordering" value="@Model.Images[i].Ordering" type="number" class="form-control" /></div>
                            <div class="col-md-2 form-check mt-2">
                                <input name="Images[@i].IsPublished" class="form-check-input" type="checkbox" value="true" @(Model.Images[i].IsPublished ? "checked" : "") />
                                <input type="hidden" name="Images[@i].IsPublished" value="false" />
                                <label class="form-check-label">Published</label>
                            </div>
                            <div class="col-md-1 form-check mt-2">
                                <input name="Images[@i].Remove" class="form-check-input" type="checkbox" value="true" />
                                <input type="hidden" name="Images[@i].Remove" value="false" />
                                <label class="form-check-label">Remove</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(isEdit ? "Update" : "Create")</button>
                    <a href="/admin/company/banners" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            let idx = @Model.Images.Count;
            const cropInstances = new Map();

            function base64ToBlob(base64String, contentType) {
                var byteCharacters = atob(base64String);
                var byteArrays = [];

                for (var offset = 0; offset < byteCharacters.length; offset += 512) {
                    var slice = byteCharacters.slice(offset, offset + 512);

                    var byteNumbers = new Array(slice.length);
                    for (var i = 0; i < slice.length; i++) {
                        byteNumbers[i] = slice.charCodeAt(i);
                    }

                    var byteArray = new Uint8Array(byteNumbers);
                    byteArrays.push(byteArray);
                }

                return new Blob(byteArrays, { type: contentType });
            }

            function applyCropperContainerStyle($container) {
                window.requestAnimationFrame(function () {
                    $container.find(".cropper-container").css({
                        width: "668px",
                        height: "631px"
                    });
                });
            }

            function imageInitialize($container) {
                const $image = $container.find(".image-crop > img");
                const $inputImage = $container.find(".js-crop-image");
                const $preview = $container.find(".img-preview");

                if (!$image.length || !$inputImage.length) return;

                const aspectRatio = parseFloat($inputImage.data("aspect-ratio")) || 1.1;
                const cropWidth = parseInt($inputImage.data("crop-width")) || 478;
                const cropHeight = parseInt($inputImage.data("crop-height")) || 825;

                const cropper = $image.cropper({
                    aspectRatio: aspectRatio,
                    preview: $preview,
                    viewMode: 1,
                    autoCropArea: 1,
                    responsive: true,
                    built: function () {
                        applyCropperContainerStyle($container);
                    }
                });

                cropInstances.set($inputImage[0], {
                    cropper: cropper,
                    width: cropWidth,
                    height: cropHeight
                });

                if (window.FileReader) {
                    $inputImage.on("change", function () {
                        var fileReader = new FileReader(),
                            files = this.files,
                            file;

                        if (!files || !files.length) {
                            return;
                        }

                        file = files[0];

                        if (/^image\/\w+$/.test(file.type)) {
                            fileReader.readAsDataURL(file);
                            fileReader.onload = function () {
                                $image.cropper("reset", true).cropper("replace", this.result);
                                applyCropperContainerStyle($container);
                            };
                        } else {
                            alert("Please choose an image file.");
                        }
                    });
                } else {
                    $inputImage.addClass("hide");
                }
            }

            function bindCropSubmit() {
                const form = document.querySelector("form");
                if (!form) return;

                form.addEventListener("submit", function () {
                    cropInstances.forEach(function (item, input) {
                        const $input = $(input);
                        const file = input.files && input.files[0];

                        if (!file) return;

                        const canvas = $input.closest(".banner-image-item")
                            .find(".image-crop > img")
                            .cropper("getCroppedCanvas", {
                                width: item.width,
                                height: item.height
                            });

                        if (!canvas) return;

                        const dataUrl = canvas.toDataURL(file.type || "image/jpeg");
                        const base64 = dataUrl.split(",")[1];
                        const blob = base64ToBlob(base64, file.type || "image/jpeg");

                        const croppedFile = new File([blob], file.name, {
                            type: file.type || "image/jpeg",
                            lastModified: new Date().getTime()
                        });

                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(croppedFile);
                        input.files = dataTransfer.files;
                    });
                });
            }

            document.getElementById("addBannerImage")?.addEventListener("click", function () {
                const wrap = document.getElementById("bannerImagesWrap");
                if (!wrap) return;

                const html = `
                <div class="row g-3 border rounded p-3 mb-3 banner-image-item">
                    <div class="col-md-3">
                        <input type="file"
                               name="Images[${idx}].Image"
                               class="form-control js-crop-image"
                               accept="image/*"
                               data-aspect-ratio="0.5793939394"
                               data-crop-width="478"
                               data-crop-height="825" />
                        <small class="text-muted">Choose image and crop before upload.</small>

                        <div class="mt-3 image-crop" style="width:100%; max-height:350px; overflow:hidden; border:1px solid #ddd;">
                            <img src="/images/placeholder.png" alt="Preview" style="max-width:100%; display:block;">
                        </div>

                        <div class="mt-2">
                            <div class="img-preview" style="width:120px; height:160px; overflow:hidden; border:1px solid #ddd;"></div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <input name="Images[${idx}].SubDescription" class="form-control" placeholder="Sub description" />
                    </div>

                    <div class="col-md-3">
                        <input name="Images[${idx}].Description" class="form-control" placeholder="Description" />
                    </div>

                    <div class="col-md-1">
                        <input name="Images[${idx}].Ordering" value="${idx}" type="number" class="form-control" />
                    </div>

                    <div class="col-md-2 form-check mt-2">
                        <input name="Images[${idx}].IsPublished" class="form-check-input" type="checkbox" value="true" checked />
                        <input type="hidden" name="Images[${idx}].IsPublished" value="false" />
                        <label class="form-check-label">Published</label>
                    </div>

                    <div class="col-md-1 form-check mt-2">
                        <input name="Images[${idx}].Remove" class="form-check-input" type="checkbox" value="true" />
                        <input type="hidden" name="Images[${idx}].Remove" value="false" />
                        <label class="form-check-label">Remove</label>
                    </div>
                </div>`;

                wrap.insertAdjacentHTML("beforeend", html);

                const $newItem = $(wrap).children().last();
                imageInitialize($newItem);

                idx++;
            });

            $(document).ready(function () {
                $(".banner-image-item").each(function () {
                    imageInitialize($(this));
                });

                bindCropSubmit();
            });
        })();
    </script>
}
