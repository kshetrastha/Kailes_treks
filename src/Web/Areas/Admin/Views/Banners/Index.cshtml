@model IReadOnlyCollection<TravelCleanArch.Domain.Entities.Banner>
@{
    ViewData["Title"] = "Company - Banners";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Company / Banners</h2>
        <a class="btn btn-primary" href="/admin/company/banners/create">Add New</a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover color-table info-table align-middle">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th style="width:80px;">Order</th>
                            <th>Title</th>
                            <th style="width:120px;">Images</th>
                            <th style="width:120px;">Status</th>
                            <th style="width:220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No banners found. Add your first banner.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.OrderBy(x => x.Ordering).ThenBy(x => x.Id))
                        {
                            <tr>
                                <td>@item.Ordering</td>
                                <td>@item.Title</td>
                                <td>@(item.Images?.Count ?? 0)</td>
                                <td>@if (item.IsPublished) { <span class="badge bg-success">Published</span> } else { <span class="badge bg-secondary">Draft</span> }</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="/admin/company/banners/@item.Id/edit">Edit</a>
                                    <form method="post" action="/admin/company/banners/@item.Id/delete" class="d-inline" onsubmit="return confirm('Delete this banner?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
