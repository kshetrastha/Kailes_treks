@model TravelCleanArch.Application.Abstractions.Travel.KailashBookingDetailsDto
@{
    ViewData["Title"] = $"Booking #{Model.Id}";
    string MonthLabel(int m) => m switch { 1=>"January",2=>"February",3=>"March",4=>"April",5=>"May",6=>"June",7=>"July",8=>"August",9=>"September",10=>"October",11=>"November",12=>"December",_=>"" };
    string StatusClass(string s) => s switch { "Confirmed"=>"badge bg-success", "Cancelled"=>"badge bg-danger", _=>"badge bg-warning text-dark" };
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">← Back to List</a>
                <strong>Booking #@Model.Id</strong>
                <span class="@StatusClass(Model.Status) ms-2">@Model.Status</span>
            </div>
            <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id" class="d-flex gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <select name="status" class="form-select form-select-sm" style="width:auto;">
                    <option value="Pending"   selected="@(Model.Status == "Pending"   ? "selected" : null)">Pending</option>
                    <option value="Confirmed" selected="@(Model.Status == "Confirmed" ? "selected" : null)">Confirmed</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                </select>
                <button class="btn btn-primary btn-sm">Update Status</button>
            </form>
        </div>
    </div>

    <div class="row gy-3">
        <!-- Tour selection -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-bold bg-light">Tour Selection</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Package</dt><dd class="col-sm-7">@Model.PackageName</dd>
                        <dt class="col-sm-5 text-muted">Month</dt><dd class="col-sm-7">@MonthLabel(Model.SelectedMonth)</dd>
                        <dt class="col-sm-5 text-muted">Arrival Date</dt><dd class="col-sm-7">@Model.ArrivalDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted">Departure Date</dt><dd class="col-sm-7">@Model.DepartureDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted">Travellers</dt><dd class="col-sm-7">@Model.NumberOfTravellers</dd>
                        <dt class="col-sm-5 text-muted">Deposit</dt><dd class="col-sm-7">USD @Model.BookingAmount.ToString("N0")</dd>
                        <dt class="col-sm-5 text-muted">Submitted</dt><dd class="col-sm-7">@Model.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Personal details -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-bold bg-light">Personal Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Full Name</dt><dd class="col-sm-7">@Model.GivenName @Model.MiddleName @Model.LastName</dd>
                        <dt class="col-sm-5 text-muted">Date of Birth</dt><dd class="col-sm-7">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted">Gender</dt><dd class="col-sm-7">@Model.Gender</dd>
                        <dt class="col-sm-5 text-muted">Email</dt><dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                        <dt class="col-sm-5 text-muted">Nationality</dt><dd class="col-sm-7">@Model.Nationality</dd>
                        <dt class="col-sm-5 text-muted">Telephone</dt><dd class="col-sm-7">@Model.TelCountryCode @Model.TelAreaCode @Model.TelNumber</dd>
                        <dt class="col-sm-5 text-muted">Mobile</dt><dd class="col-sm-7">@Model.MobileNumber</dd>
                        <dt class="col-sm-5 text-muted">Occupation</dt><dd class="col-sm-7">@Model.Occupation</dd>
                        <dt class="col-sm-5 text-muted">Address</dt><dd class="col-sm-7">@Model.Address, @Model.City @Model.PostalCode, @Model.Country</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Passport -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-bold bg-light">Passport &amp; Travel</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Passport No.</dt><dd class="col-sm-7">@Model.PassportNumber</dd>
                        <dt class="col-sm-5 text-muted">Place of Issue</dt><dd class="col-sm-7">@Model.PlaceOfIssue</dd>
                        <dt class="col-sm-5 text-muted">Date of Issue</dt><dd class="col-sm-7">@Model.DateOfIssue.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted">Expiry Date</dt><dd class="col-sm-7">@Model.ExpiryDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted">Insurance</dt><dd class="col-sm-7">@(Model.Insurance ?? "—")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Emergency contact -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-bold bg-light">Emergency Contact</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Name</dt><dd class="col-sm-7">@Model.EmergencyName</dd>
                        <dt class="col-sm-5 text-muted">Relationship</dt><dd class="col-sm-7">@Model.EmergencyRelationship</dd>
                        <dt class="col-sm-5 text-muted">Telephone</dt><dd class="col-sm-7">@Model.EmergencyTelCountryCode @Model.EmergencyTelAreaCode @Model.EmergencyTelNumber</dd>
                        <dt class="col-sm-5 text-muted">Mobile</dt><dd class="col-sm-7">@Model.EmergencyMobile</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Health declaration -->
        <div class="col-12">
            <div class="card">
                <div class="card-header fw-bold bg-light">Self-Health Declaration</div>
                <div class="card-body">
                    @if (Model.HealthDeclaration.Any())
                    {
                        <div class="row g-2">
                            @foreach (var kv in Model.HealthDeclaration)
                            {
                                <div class="col-md-3 col-sm-4 col-6">
                                    <span class="badge @(kv.Value ? "bg-danger" : "bg-success") me-1">@(kv.Value ? "✓ Has" : "✗ None")</span>
                                    <small>@kv.Key</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">No health declaration recorded.</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OtherHealthConcerns))
                    {
                        <p class="mt-2 mb-0"><strong>Other:</strong> @Model.OtherHealthConcerns</p>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SpecialRequests))
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-bold bg-light">Special Requests</div>
                    <div class="card-body"><p class="mb-0">@Model.SpecialRequests</p></div>
                </div>
            </div>
        }
    </div>
</div>
