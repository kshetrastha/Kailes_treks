@model TravelCleanArch.Application.Abstractions.Travel.KailashBookingPagedResult
@{
    ViewData["Title"] = "Kailash Bookings";
    var search = ViewBag.Search as string ?? "";
    var statusFilter = ViewBag.Status as string ?? "";
    int totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);

    string MonthLabel(int m) => m switch { 1=>"Jan",2=>"Feb",3=>"Mar",4=>"Apr",5=>"May",6=>"Jun",7=>"Jul",8=>"Aug",9=>"Sep",10=>"Oct",11=>"Nov",12=>"Dec",_=>"" };
    string StatusClass(string s) => s switch { "Confirmed"=>"badge bg-success", "Cancelled"=>"badge bg-danger", _=>"badge bg-warning text-dark" };
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter card -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label text-muted">Search name or email</label>
                    <input name="search" type="text" class="form-control" placeholder="Name or email…" value="@search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Pending"   selected="@(statusFilter == "Pending"   ? "selected" : null)">Pending</option>
                        <option value="Confirmed" selected="@(statusFilter == "Confirmed" ? "selected" : null)">Confirmed</option>
                        <option value="Cancelled" selected="@(statusFilter == "Cancelled" ? "selected" : null)">Cancelled</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" type="submit"><i class="fa fa-search me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Clear</a>
                </div>
                <div class="col-auto ms-auto">
                    <a asp-action="Packages" class="btn btn-outline-info">
                        <i class="fa-solid fa-list me-1"></i>Manage Packages
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bookings table card -->
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">Kailash Manasarovar Yatra – Bookings</h5>
                <small class="text-muted">@Model.TotalCount total booking(s)</small>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Package</th>
                            <th>Month</th>
                            <th>Travellers</th>
                            <th>Deposit (USD)</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr><td colspan="10" class="text-center text-muted py-4">No bookings found.</td></tr>
                        }
                        @foreach (var b in Model.Items)
                        {
                            <tr>
                                <td>@b.Id</td>
                                <td>@b.FullName</td>
                                <td><a href="mailto:@b.Email">@b.Email</a></td>
                                <td style="max-width:200px;white-space:normal;font-size:12px;">@b.PackageName</td>
                                <td>@MonthLabel(b.SelectedMonth)</td>
                                <td class="text-center">@b.NumberOfTravellers</td>
                                <td>$@b.BookingAmount.ToString("N0")</td>
                                <td><span class="@StatusClass(b.Status)">@b.Status</span></td>
                                <td style="font-size:12px;white-space:nowrap;">@b.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="BookingDetail" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                   asp-route-search="@search" asp-route-status="@statusFilter">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
