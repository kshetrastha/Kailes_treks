@model IReadOnlyCollection<TravelCleanArch.Domain.Entities.MapDestination>
@{
    ViewData["Title"] = "Map Destinations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Map Destination Details</h4>
    <a asp-action="Create" class="btn btn-primary">Add Destination</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Short Description</th>
                    <th>Hero Image</th>
                    <th>Images</th>
                    <th>Published</th>
                    <th>Order</th>
                    <th class="text-end">Action</th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No map destination data found.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.ShortDescription</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.HeroImagePath))
                                {
                                    <img src="/@item.HeroImagePath" alt="Hero" style="width: 72px; height: 48px; object-fit: cover; border-radius: 6px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </td>
                            <td>@item.Images.Count</td>
                            <td>@(item.IsPublished ? "Yes" : "No")</td>
                            <td>@item.Ordering</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this destination detail?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
