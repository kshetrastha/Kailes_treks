@model IReadOnlyCollection<TravelCleanArch.Domain.Entities.Master.ServiceType>
@{
    ViewData["Title"] = "Travel - Service Types";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Travel / Service Types</h2>
        <a class="btn btn-primary" href="/admin/service-types/create">Add New</a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="card">
        <div class="card-body">
            <div id="no-more-tables" class="table-responsive mb-2">
                <table class="table table-hover color-table info-table align-middle">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th style="width: 100px;">Id</th>
                            <th style="min-width: 240px;">Name</th>
                            <th style="width: 190px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No service types found. Add your first service type.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="Id">@item.Id</td>
                                    <td data-label="Name">@item.Name</td>
                                    <td data-label="Actions">
                                        <a class="btn btn-sm btn-outline-primary" href="/admin/service-types/@item.Id/edit">Edit</a>
                                        <form method="post" action="/admin/service-types/@item.Id/delete" class="d-inline" onsubmit="return confirm('Delete this service type?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
