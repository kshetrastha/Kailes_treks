@model IReadOnlyCollection<TravelCleanArch.Domain.Entities.Patron>
@{
    ViewData["Title"] = "Company - Patrons";
    var allowedPageSizes = new[] { 10, 20, 50, 100, -1 };
    var page = int.TryParse(Context.Request.Query["page"], out var qPage) ? qPage : 1;
    var pageSize = int.TryParse(Context.Request.Query["pageSize"], out var qPageSize) ? qPageSize : 10;
    var currentPage = Math.Max(1, page);
    var currentPageSize = allowedPageSizes.Contains(pageSize) ? pageSize : 10;
    var allItems = Model.ToList();
    var totalCount = allItems.Count;
    var effectivePageSize = currentPageSize == -1 ? Math.Max(1, totalCount) : currentPageSize;
    var totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)effectivePageSize));
    if (currentPage > totalPages) { currentPage = totalPages; }
    var pagedItems = currentPageSize == -1 ? allItems : allItems.Skip((currentPage - 1) * currentPageSize).Take(currentPageSize).ToList();
    var firstItemIndex = totalCount == 0 ? 0 : ((currentPage - 1) * effectivePageSize) + 1;
    var lastItemIndex = totalCount == 0 ? 0 : Math.Min(currentPage * effectivePageSize, totalCount);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Company / Patrons</h2><a class="btn btn-primary" href="/admin/company/patrons/create">Add New</a></div>
    @if (TempData["SuccessMessage"] is string message){<div class="alert alert-success">@message</div>}
    <div class="card"><div class="card-body"><div id="no-more-tables" class="table-responsive mb-2"><table class="table table-hover color-table info-table align-middle">
        <thead class="bg-primary text-white"><tr><th style="width:90px;">Order</th><th>Name</th><th>Role</th><th style="width:95px;">Image</th><th style="width:110px;">Status</th><th style="width:190px;">Actions</th></tr></thead>
        <tbody>
        @if(!pagedItems.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No patrons found. Add your first patron.</td></tr>
        }
        else
        {
            @foreach(var item in pagedItems)
            {
                <tr>
                    <td data-label="Order">@item.Ordering</td><td data-label="Name">@item.Name</td><td data-label="Role">@item.Role</td>
                    <td data-label="Image">@if(!string.IsNullOrWhiteSpace(item.ImagePath)){<img src="/@item.ImagePath" alt="@item.Name" style="width: 48px; height: 48px; object-fit: cover; border-radius: 9999px;" />}else{<span>-</span>}</td>
                    <td data-label="Status">@if(item.IsPublished){<span class="badge bg-success">Published</span>}else{<span class="badge bg-secondary">Draft</span>}</td>
                    <td data-label="Actions"><a class="btn btn-sm btn-outline-primary" href="/admin/company/patrons/@item.Id/edit">Edit</a><form method="post" action="/admin/company/patrons/@item.Id/delete" class="d-inline" onsubmit="return confirm('Delete this item?');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button></form></td>
                </tr>
            }
        }
        </tbody>
    </table></div>
    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        <form method="get" class="d-flex align-items-center gap-2"><input type="hidden" name="page" value="1" /><label class="text-muted small mb-0" for="pageSize">Rows / Page</label><select id="pageSize" name="pageSize" class="form-select form-select-sm" style="width: 130px;" onchange="this.form.submit()"><option value="10" selected="@(currentPageSize == 10)">10 Rows/Page</option><option value="20" selected="@(currentPageSize == 20)">20 Rows/Page</option><option value="50" selected="@(currentPageSize == 50)">50 Rows/Page</option><option value="100" selected="@(currentPageSize == 100)">100 Rows/Page</option><option value="-1" selected="@(currentPageSize == -1)">All Rows/Page</option></select></form>
        <div class="text-muted small">Showing @firstItemIndex to @lastItemIndex of @totalCount records</div>
        <nav aria-label="Pagination"><ul class="pagination pagination-sm mb-0"><li class="page-item @(currentPage <= 1 ? "disabled" : null)"><a class="page-link" href="?page=@(currentPage - 1)&pageSize=@currentPageSize">Previous</a></li>@for (var p = 1; p <= totalPages; p++){<li class="page-item @(p == currentPage ? "active" : null)"><a class="page-link" href="?page=@p&pageSize=@currentPageSize">@p</a></li>}<li class="page-item @(currentPage >= totalPages ? "disabled" : null)"><a class="page-link" href="?page=@(currentPage + 1)&pageSize=@currentPageSize">Next</a></li></ul></nav>
    </div></div></div>
</div>
