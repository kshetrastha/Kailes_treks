generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
  CUSTOMER
}

enum TravelStatus {
  Draft
  Published
  Archived
}

enum DifficultyLevel {
  Easy
  Moderate
  Challenging
  Difficult
  Extreme
}

enum Season {
  Spring
  Summer
  Autumn
  Winter
  AllYear
}

enum Country {
  Nepal
  Tibet
  Bhutan
  India
}

enum DepartureStatus {
  BookingCreated
  Guaranteed
  SoldOut
  Cancelled
}

enum CostItemType {
  Include
  Exclude
}

enum MediaKind {
  Photo
  Video
  Document
  Map
}

enum ReviewModerationStatus {
  Pending
  Approved
  Rejected
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  fullName      String    @default("")
  role          RoleName  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model TrekkingType {
  id               Int                 @id @default(autoincrement())
  title            String
  shortDescription String              @default("")
  description      String?             @db.Text
  imagePath        String?
  ordering         Int                 @default(0)
  isPublished      Boolean             @default(true)
  country          Country             @default(Nepal)
  hasRegions       Boolean             @default(true)
  trekkings        Trekking[]
  images           TrekkingTypeImage[]
  createdAtUtc     DateTime            @default(now())
  updatedAtUtc     DateTime            @updatedAt
  isActive         Boolean             @default(true)

  @@map("TrekkingTypes")
}

model TrekkingTypeImage {
  id             Int          @id @default(autoincrement())
  trekkingTypeId Int
  filePath       String
  altText        String?
  sortOrder      Int          @default(0)
  isCover        Boolean      @default(false)
  isActive       Boolean      @default(true)
  trekkingType   TrekkingType @relation(fields: [trekkingTypeId], references: [id], onDelete: Cascade)
  createdAtUtc   DateTime     @default(now())
  updatedAtUtc   DateTime     @updatedAt
}

model ServiceType {
  id           Int             @id @default(autoincrement())
  name         String
  slugURL      String?
  description  String?         @db.Text
  ordering     Int             @default(0)
  regions      ServiceRegion[]
  createdAtUtc DateTime        @default(now())
  updatedAtUtc DateTime        @updatedAt
  isActive     Boolean         @default(true)
}

model ServiceRegion {
  id            Int                @id @default(autoincrement())
  name          String
  description   String?            @db.Text
  serviceTypeId Int?
  serviceType   ServiceType?       @relation(fields: [serviceTypeId], references: [id])
  reason        String             @default("")
  slugURL       String?            @unique
  ordering      Int                @default(0)
  faqs          ServiceRegionFaq[]
  createdAtUtc  DateTime           @default(now())
  updatedAtUtc  DateTime           @updatedAt
  isActive      Boolean            @default(true)
}

model ServiceRegionFaq {
  id              Int            @id @default(autoincrement())
  serviceRegionId Int
  question        String
  answer          String         @db.Text
  ordering        Int            @default(0)
  isPublished     Boolean        @default(true)
  serviceRegion   ServiceRegion  @relation(fields: [serviceRegionId], references: [id], onDelete: Cascade)
  createdAtUtc    DateTime       @default(now())
  updatedAtUtc    DateTime       @updatedAt
  isActive        Boolean        @default(true)
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String?  @unique
  description  String?  @db.Text
  ordering     Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model Accomodation {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?  @db.Text
  ordering     Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model DifficultyLevelMaster {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?  @db.Text
  ordering     Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
  @@map("DifficultyLevels")
}

model Trekking {
  id                     Int                       @id @default(autoincrement())
  trekkingTypeId         Int?
  trekkingType           TrekkingType?             @relation(fields: [trekkingTypeId], references: [id])
  name                   String
  slug                   String                    @unique
  shortDescription       String                    @default("") @db.Text
  destination            String                    @default("")
  region                 String?
  durationDays           Int                       @default(0)
  maxAltitudeMeters      Int                       @default(0)
  maxAltitudeFeet        Int?
  difficultyLevel        DifficultyLevel?
  bestSeason             Season?
  walkingPerDay          String?
  accommodation          String?
  overview               String?                   @db.Text
  overviewCountry        Country                   @default(Nepal)
  peakName               String?
  route                  String?
  rank                   String?
  latitude               Decimal?                  @db.Decimal(10, 7)
  longitude              Decimal?                  @db.Decimal(10, 7)
  coordinatesText        String?
  weatherReportUrl       String?
  range                  String?
  heroImageUrl           String?
  heroVideoUrl           String?
  minGroupSize           Int                       @default(1)
  maxGroupSize           Int                       @default(1)
  groupSizeText          String?
  priceOnRequest         Boolean                   @default(false)
  price                  Decimal?                  @db.Decimal(12, 2)
  currencyCode           String?                   @default("USD")
  priceNotesUrl          String?
  tripPdfUrl             String?
  seoTitle               String?
  seoDescription         String?
  averageRating          Decimal?                  @db.Decimal(3, 2)
  ratingLabel            String?
  reviewCount            Int?
  status                 TravelStatus              @default(Draft)
  featured               Boolean                   @default(false)
  ordering               Int                       @default(0)
  expeditionStyle        String?
  boardBasis             String?
  oxygenSupport          Boolean                   @default(false)
  sherpaSupport          Boolean                   @default(false)
  summitBonusUsd         Decimal?                  @db.Decimal(12, 2)
  permits                String?                   @db.Text
  requiresClimbingPermit Boolean                   @default(false)
  inclusions             String?                   @db.Text
  exclusions             String?                   @db.Text
  availableDates         String?
  bookingCtaUrl          String?
  summitRoute            String?
  overviewDuration       String?
  faqs                   TrekkingFaq[]
  mediaItems             TrekkingMedia[]
  itineraries            TrekkingItinerary[]
  maps                   TrekkingMap[]
  costItems              TrekkingCostItem[]
  fixedDepartures        TrekkingFixedDeparture[]
  gearLists              TrekkingGearList[]
  highlights             TrekkingHighlight[]
  reviews                TrekkingReview[]
  createdAtUtc           DateTime                  @default(now())
  updatedAtUtc           DateTime                  @updatedAt
  isActive               Boolean                   @default(true)
}

model TrekkingFaq {
  id           Int      @id @default(autoincrement())
  trekkingId   Int
  question     String
  answer       String   @db.Text
  ordering     Int      @default(0)
  trekking     Trekking @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model TrekkingMedia {
  id           Int       @id @default(autoincrement())
  trekkingId   Int
  url          String
  caption      String?
  mediaType    String    @default("image")
  ordering     Int       @default(0)
  filePath     String?
  videoUrl     String?
  mediaKind    MediaKind @default(Photo)
  trekking     Trekking  @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime  @default(now())
  updatedAtUtc DateTime  @updatedAt
  isActive     Boolean   @default(true)
}

model TrekkingItinerary {
  id           Int                    @id @default(autoincrement())
  trekkingId   Int
  seasonTitle  String
  sortOrder    Int                    @default(0)
  trekking     Trekking               @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  days         TrekkingItineraryDay[]
  createdAtUtc DateTime               @default(now())
  updatedAtUtc DateTime               @updatedAt
  isActive     Boolean                @default(true)
}

model TrekkingItineraryDay {
  id                  Int               @id @default(autoincrement())
  trekkingItineraryId Int
  dayNumber           Int
  shortDescription    String?
  description         String?           @db.Text
  meals               String?
  accommodationType   String?
  itinerary           TrekkingItinerary @relation(fields: [trekkingItineraryId], references: [id], onDelete: Cascade)
  createdAtUtc        DateTime          @default(now())
  updatedAtUtc        DateTime          @updatedAt
  isActive            Boolean           @default(true)
}

model TrekkingMap {
  id           Int      @id @default(autoincrement())
  trekkingId   Int
  filePath     String
  title        String?
  notes        String?  @db.Text
  trekking     Trekking @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model TrekkingCostItem {
  id           Int          @id @default(autoincrement())
  trekkingId   Int
  type         CostItemType
  text         String       @db.Text
  sortOrder    Int          @default(0)
  trekking     Trekking     @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime     @default(now())
  updatedAtUtc DateTime     @updatedAt
  isActive     Boolean      @default(true)
}

model TrekkingFixedDeparture {
  id           Int             @id @default(autoincrement())
  trekkingId   Int
  startDate    DateTime
  endDate      DateTime
  forDays      Int
  status       DepartureStatus @default(BookingCreated)
  groupSize    Int?
  trekking     Trekking        @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime        @default(now())
  updatedAtUtc DateTime        @updatedAt
  isActive     Boolean         @default(true)
}

model TrekkingGearList {
  id               Int      @id @default(autoincrement())
  trekkingId       Int
  shortDescription String?  @db.Text
  imagePath        String?
  filePath         String
  trekking         Trekking @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc     DateTime @default(now())
  updatedAtUtc     DateTime @updatedAt
  isActive         Boolean  @default(true)
}

model TrekkingHighlight {
  id           Int      @id @default(autoincrement())
  trekkingId   Int
  text         String   @db.Text
  sortOrder    Int      @default(0)
  trekking     Trekking @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model TrekkingReview {
  id               Int                    @id @default(autoincrement())
  trekkingId       Int
  fullName         String
  emailAddress     String
  userPhotoPath    String?
  videoUrl         String?
  rating           Int
  reviewText       String                 @db.Text
  moderationStatus ReviewModerationStatus @default(Pending)
  trekking         Trekking               @relation(fields: [trekkingId], references: [id], onDelete: Cascade)
  createdAtUtc     DateTime               @default(now())
  updatedAtUtc     DateTime               @updatedAt
  isActive         Boolean                @default(true)
}
model ExpeditionType {
  id               Int          @id @default(autoincrement())
  title            String
  shortDescription String       @default("")
  description      String?      @db.Text
  imagePath        String?
  ordering         Int          @default(0)
  isPublished      Boolean      @default(true)
  expeditions      Expedition[]
  createdAtUtc     DateTime     @default(now())
  updatedAtUtc     DateTime     @updatedAt
  isActive         Boolean      @default(true)
}

model Expedition {
  id                     Int                       @id @default(autoincrement())
  expeditionTypeId       Int?
  expeditionType         ExpeditionType?           @relation(fields: [expeditionTypeId], references: [id])
  name                   String
  slug                   String                    @unique
  shortDescription       String                    @default("") @db.Text
  destination            String                    @default("")
  region                 String?
  durationDays           Int                       @default(0)
  maxAltitudeMeters      Int                       @default(0)
  difficultyLevel        DifficultyLevel?
  bestSeason             Season?
  overview               String?                   @db.Text
  overviewCountry        Country                   @default(Nepal)
  peakName               String?
  route                  String?
  latitude               Decimal?                  @db.Decimal(10, 7)
  longitude              Decimal?                  @db.Decimal(10, 7)
  heroImageUrl           String?
  heroVideoUrl           String?
  minGroupSize           Int                       @default(1)
  maxGroupSize           Int                       @default(1)
  priceOnRequest         Boolean                   @default(false)
  price                  Decimal?                  @db.Decimal(12, 2)
  currencyCode           String?                   @default("USD")
  seoTitle               String?
  seoDescription         String?
  status                 TravelStatus              @default(Draft)
  featured               Boolean                   @default(false)
  ordering               Int                       @default(0)
  inclusions             String?                   @db.Text
  exclusions             String?                   @db.Text
  faqs                   ExpeditionFaq[]
  mediaItems             ExpeditionMedia[]
  itineraries            Itinerary[]
  maps                   ExpeditionMap[]
  costItems              CostItem[]
  fixedDepartures        FixedDeparture[]
  gearLists              GearList[]
  highlights             ExpeditionHighlight[]
  reviews                ExpeditionReview[]
  createdAtUtc           DateTime                  @default(now())
  updatedAtUtc           DateTime                  @updatedAt
  isActive               Boolean                   @default(true)
}

model ExpeditionFaq {
  id           Int        @id @default(autoincrement())
  expeditionId Int
  question     String
  answer       String     @db.Text
  ordering     Int        @default(0)
  expedition   Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime   @default(now())
  updatedAtUtc DateTime   @updatedAt
  isActive     Boolean    @default(true)
}

model ExpeditionMedia {
  id           Int        @id @default(autoincrement())
  expeditionId Int
  url          String
  caption      String?
  mediaType    String     @default("image")
  ordering     Int        @default(0)
  filePath     String?
  videoUrl     String?
  mediaKind    MediaKind  @default(Photo)
  expedition   Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime   @default(now())
  updatedAtUtc DateTime   @updatedAt
  isActive     Boolean    @default(true)
}

model Itinerary {
  id           Int            @id @default(autoincrement())
  expeditionId Int
  seasonTitle  String
  sortOrder    Int            @default(0)
  expedition   Expedition     @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  days         ItineraryDay[]
  createdAtUtc DateTime       @default(now())
  updatedAtUtc DateTime       @updatedAt
  isActive     Boolean        @default(true)
}

model ItineraryDay {
  id                Int       @id @default(autoincrement())
  itineraryId       Int
  dayNumber         Int
  shortDescription  String?
  description       String?   @db.Text
  meals             String?
  accommodationType String?
  itinerary         Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  createdAtUtc      DateTime  @default(now())
  updatedAtUtc      DateTime  @updatedAt
  isActive          Boolean   @default(true)
}

model ExpeditionMap {
  id           Int        @id @default(autoincrement())
  expeditionId Int
  filePath     String
  title        String?
  notes        String?    @db.Text
  expedition   Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime   @default(now())
  updatedAtUtc DateTime   @updatedAt
  isActive     Boolean    @default(true)
}

model CostItem {
  id           Int          @id @default(autoincrement())
  expeditionId Int
  type         CostItemType
  text         String       @db.Text
  sortOrder    Int          @default(0)
  expedition   Expedition   @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime     @default(now())
  updatedAtUtc DateTime     @updatedAt
  isActive     Boolean      @default(true)
}

model FixedDeparture {
  id           Int             @id @default(autoincrement())
  expeditionId Int
  startDate    DateTime
  endDate      DateTime
  forDays      Int
  status       DepartureStatus @default(BookingCreated)
  groupSize    Int?
  expedition   Expedition      @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime        @default(now())
  updatedAtUtc DateTime        @updatedAt
  isActive     Boolean         @default(true)
}

model GearList {
  id               Int        @id @default(autoincrement())
  expeditionId     Int
  shortDescription String?    @db.Text
  imagePath        String?
  filePath         String
  expedition       Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc     DateTime   @default(now())
  updatedAtUtc     DateTime   @updatedAt
  isActive         Boolean    @default(true)
}

model ExpeditionHighlight {
  id           Int        @id @default(autoincrement())
  expeditionId Int
  text         String     @db.Text
  sortOrder    Int        @default(0)
  expedition   Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc DateTime   @default(now())
  updatedAtUtc DateTime   @updatedAt
  isActive     Boolean    @default(true)
}

model ExpeditionReview {
  id               Int                    @id @default(autoincrement())
  expeditionId     Int
  fullName         String
  emailAddress     String
  userPhotoPath    String?
  videoUrl         String?
  rating           Int
  reviewText       String                 @db.Text
  moderationStatus ReviewModerationStatus @default(Pending)
  expedition       Expedition             @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdAtUtc     DateTime               @default(now())
  updatedAtUtc     DateTime               @updatedAt
  isActive         Boolean                @default(true)
}

model BlogPost {
  id                 Int       @id @default(autoincrement())
  title              String
  slug               String    @unique
  summary            String?   @db.Text
  contentHtml        String    @db.Text
  heroImagePath      String?
  thumbnailImagePath String?
  publishedOnUtc     DateTime?
  ordering           Int       @default(0)
  isFeatured         Boolean   @default(false)
  isPublished        Boolean   @default(true)
  createdAtUtc       DateTime  @default(now())
  updatedAtUtc       DateTime  @updatedAt
  isActive           Boolean   @default(true)
}

model Banner {
  id             Int           @id @default(autoincrement())
  title          String
  subDescription String?
  description    String?       @db.Text
  ordering       Int           @default(0)
  isPublished    Boolean       @default(true)
  images         BannerImage[]
  createdAtUtc   DateTime      @default(now())
  updatedAtUtc   DateTime      @updatedAt
  isActive       Boolean       @default(true)
}

model BannerImage {
  id             Int      @id @default(autoincrement())
  bannerId       Int
  imagePath      String
  subDescription String?
  description    String?  @db.Text
  ordering       Int      @default(0)
  isPublished    Boolean  @default(true)
  banner         Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  createdAtUtc   DateTime @default(now())
  updatedAtUtc   DateTime @updatedAt
  isActive       Boolean  @default(true)
}

model MasterFaq {
  id           Int      @id @default(autoincrement())
  question     String
  answer       String   @db.Text
  ordering     Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model Inquiry {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  phone           String?
  travelSlug      String?
  preferredDate   DateTime?
  people          Int?
  message         String   @db.Text
  isResolved      Boolean  @default(false)
  createdAtUtc    DateTime @default(now())
}

model NewsletterSubscription {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  isActive     Boolean  @default(true)
  createdAtUtc DateTime @default(now())
}
